    <string name="chatbot_draft_contract_introduction">UI illustration only. This is not extracted from your file or legal advice. The parties must review and complete it before use.</string>
    <string name="chatbot_draft_section_1_title">Article 1. Parties</string>
    <string name="chatbot_draft_section_1_body">Employer: [NAME, ADDRESS, REPRESENTATIVE AND TITLE].
Employee: [FULL NAME, DATE OF BIRTH, ADDRESS, ID DOCUMENT].
Bracketed fields are placeholders and do not identify real people or businesses.</string>
    <string name="chatbot_draft_section_2_title">Article 2. Work and workplace</string>
    <string name="chatbot_draft_section_2_body">Job title/work: [TITLE AND DESCRIPTION]. Workplace: [LOCATION]. The employee performs the agreed work under applicable requirements.
Any change to the work or workplace must be reviewed and agreed in accordance with applicable law.</string>
    <string name="chatbot_draft_section_3_title">Article 3. Contract term — illustration</string>
    <string name="chatbot_draft_section_3_body">Contract type and term: [INDEFINITE / FIXED TERM]; start date: [DATE]; end date if applicable: [DATE].
This is an illustrative field. Confirm the appropriate contract type and term before signing.</string>
    <string name="chatbot_draft_section_4_title">Article 4. Salary and additional payments</string>
    <string name="chatbot_draft_section_4_body">Job/position-based salary: [AMOUNT AND UNIT]. Payment method and due date: [AGREEMENT]. Allowances and other additional payments: [DETAILS].
These are placeholders only. The parties must agree and review them before use.</string>
    <string name="chatbot_draft_section_5_title">Article 5. Working hours and rest periods</string>
    <string name="chatbot_draft_section_5_body">Working hours, rest periods and schedule: [SPECIFIC AGREEMENT]. Actual terms must fit the job and applicable requirements.</string>
    <string name="chatbot_draft_section_6_title">Article 6. Rights and obligations</string>
    <string name="chatbot_draft_section_6_body">Employer: [RIGHTS AND RESPONSIBILITIES UNDER THE AGREEMENT]. Employee: [RIGHTS AND RESPONSIBILITIES UNDER THE AGREEMENT].
The parties must agree and review the details under applicable requirements.</string>
    <string name="chatbot_draft_section_7_title">Article 7. Termination and breach</string>
    <string name="chatbot_draft_section_7_body">Amendment, suspension or termination: [AGREEMENT OF THE PARTIES].
The parties follow the process, rights and obligations required by applicable law. This sample does not set a notice period or penalty.</string>
    <string name="chatbot_draft_section_8_title">Article 8. Dispute resolution</string>
    <string name="chatbot_draft_section_8_body">The parties should first communicate to resolve disagreements under applicable requirements. Notice contact: [CONTACT DETAILS FOR EACH PARTY].</string>
    <string name="chatbot_draft_section_9_title">Article 9. Effectiveness and signatures</string>
    <string name="chatbot_draft_section_9_body">Effective date: [DATE]. The contract is made in [NUMBER] copies after the parties complete and sign it.
EMPLOYER                                  EMPLOYEE
[REPRESENTATIVE AND TITLE]               [FULL NAME]
DEMO · Unsigned · Complete and review all [bracketed] fields.</string>
