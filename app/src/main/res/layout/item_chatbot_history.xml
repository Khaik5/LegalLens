<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/chatbot_history_item_height"
    android:layout_marginBottom="@dimen/chatbot_history_item_spacing"
    android:background="@drawable/bg_chatbot_history_card"
    android:orientation="vertical"
    android:padding="@dimen/chatbot_history_item_padding">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/chatbot_history_row_height">

        <ImageView
            android:id="@+id/chatbotHistoryIcon"
            android:layout_width="@dimen/chatbot_history_icon_size"
            android:layout_height="@dimen/chatbot_history_icon_size"
            android:background="@drawable/bg_chatbot_history_icon"
            android:contentDescription="@null"
            android:padding="@dimen/chatbot_history_icon_padding"
            android:src="@drawable/ic_chatbot_history_message"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/chatbotHistoryContractName"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_18"
            android:layout_marginStart="@dimen/chatbot_history_item_text_margin_start"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/chatbotHistoryMessageCount"
            app:layout_constraintStart_toEndOf="@id/chatbotHistoryIcon"
            app:layout_constraintTop_toTopOf="@id/chatbotHistoryIcon" />

        <TextView
            android:id="@+id/chatbotHistoryTimestamp"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_18"
            android:layout_marginTop="@dimen/chatbot_history_metadata_margin_top"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_13"
            app:layout_constraintEnd_toStartOf="@id/chatbotHistoryMessageCount"
            app:layout_constraintStart_toStartOf="@id/chatbotHistoryContractName"
            app:layout_constraintTop_toBottomOf="@id/chatbotHistoryContractName" />

        <TextView
            android:id="@+id/chatbotHistoryMessageCount"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_23"
            android:layout_marginStart="@dimen/chatbot_history_badge_margin_start"
            android:background="@drawable/bg_chatbot_history_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/chatbot_history_badge_horizontal_padding"
            android:paddingEnd="@dimen/chatbot_history_badge_horizontal_padding"
            android:textColor="@color/legal_lens_auth_accent"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/chatbotHistoryPreview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_18"
        android:layout_marginTop="@dimen/chatbot_history_preview_margin_top"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/legal_lens_secondary_text"
        android:textSize="@dimen/sp_13" />
</LinearLayout>
