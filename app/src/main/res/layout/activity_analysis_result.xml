<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/analysis_result_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocr_saved_background">

    <LinearLayout
        android:id="@+id/analysis_result_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/analysis_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/analysis_header_side_padding"
        android:paddingEnd="@dimen/analysis_header_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/analysis_result_back"
            android:layout_width="@dimen/analysis_back_button_size"
            android:layout_height="@dimen/analysis_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/analysis_result_back_content_description"
            android:padding="@dimen/analysis_back_icon_padding"
            android:src="@drawable/ic_upload_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/analysis_header_title_margin_start"
            android:layout_weight="1"
            android:text="@string/analysis_result_title"
            android:textColor="@color/ocr_saved_navy"
            android:textSize="@dimen/analysis_header_title_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/analysis_result_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/analysis_content_side_padding"
            android:paddingTop="@dimen/analysis_result_content_top_padding"
            android:paddingEnd="@dimen/analysis_content_side_padding"
            android:paddingBottom="@dimen/analysis_result_content_bottom_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_document_card_height"
                android:background="@drawable/bg_analysis_document_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/analysis_document_card_padding"
                android:paddingEnd="@dimen/analysis_document_card_padding">

                <FrameLayout
                    android:layout_width="@dimen/analysis_document_icon_size"
                    android:layout_height="@dimen/analysis_document_icon_size"
                    android:background="@drawable/bg_ocr_saved_document_icon">

                    <ImageView
                        android:layout_width="@dimen/analysis_document_icon_art_size"
                        android:layout_height="@dimen/analysis_document_icon_art_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ocr_saved_document" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/analysis_document_text_margin_start"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/analysis_result_document_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/ocr_saved_navy"
                        android:textSize="@dimen/analysis_document_name_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/analysis_result_document_metadata"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/analysis_document_metadata_margin_top"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/ocr_saved_body"
                        android:textSize="@dimen/analysis_document_metadata_text_size" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_result_risk_card_height"
                android:layout_marginTop="@dimen/analysis_result_card_margin_top"
                android:background="@drawable/bg_analysis_result_card_large"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/analysis_result_risk_card_padding">

                <FrameLayout
                    android:layout_width="@dimen/analysis_result_score_size"
                    android:layout_height="@dimen/analysis_result_score_size">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_analysis_result_score_ring" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/analysis_result_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/ocr_saved_navy"
                            android:textSize="@dimen/analysis_result_score_text_size"
                             />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/analysis_result_score_label_margin_top"
                            android:text="@string/analysis_result_score_label"
                            android:textColor="@color/ocr_saved_body"
                            android:textSize="@dimen/analysis_result_score_label_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/analysis_result_risk_text_margin_start"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analysis_result_risk_heading"
                            android:textColor="@color/ocr_saved_navy"
                            android:textSize="@dimen/analysis_result_risk_heading_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/analysis_result_medium_badge_height"
                            android:layout_marginStart="@dimen/analysis_result_medium_badge_margin_start"
                            android:background="@drawable/bg_analysis_result_medium_badge"
                            android:gravity="center"
                            android:paddingStart="@dimen/analysis_result_medium_badge_padding_horizontal"
                            android:paddingEnd="@dimen/analysis_result_medium_badge_padding_horizontal"
                            android:text="@string/analysis_result_medium"
                            android:textColor="@color/contract_pending"
                            android:textSize="@dimen/analysis_result_medium_badge_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/analysis_result_risk_description_margin_top"
                        android:lineSpacingExtra="@dimen/analysis_result_risk_description_line_spacing"
                        android:text="@string/analysis_result_risk_assessment_description"
                        android:textColor="@color/ocr_saved_body"
                        android:textSize="@dimen/analysis_result_risk_description_text_size" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_result_metrics_height"
                android:layout_marginTop="@dimen/analysis_result_metrics_margin_top"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_analysis_result_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/analysis_result_key_facts_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ocr_saved_teal"
                        android:textSize="@dimen/analysis_result_metric_value_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/analysis_result_metric_label_margin_top"
                        android:text="@string/analysis_result_key_facts"
                        android:textColor="@color/ocr_saved_body"
                        android:textSize="@dimen/analysis_result_metric_label_text_size" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/analysis_result_metrics_spacing"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_analysis_result_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/analysis_result_risk_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/analysis_result_risk"
                        android:textSize="@dimen/analysis_result_metric_value_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/analysis_result_metric_label_margin_top"
                        android:text="@string/analysis_result_risks"
                        android:textColor="@color/ocr_saved_body"
                        android:textSize="@dimen/analysis_result_metric_label_text_size" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/analysis_result_metrics_spacing"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_analysis_result_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/analysis_result_reference_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ocr_saved_navy"
                        android:textSize="@dimen/analysis_result_metric_value_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/analysis_result_metric_label_margin_top"
                        android:text="@string/analysis_result_references"
                        android:textColor="@color/ocr_saved_body"
                        android:textSize="@dimen/analysis_result_metric_label_text_size" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/analysis_result_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/analysis_result_items_margin_top"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
