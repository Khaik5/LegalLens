<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/analysisRiskOverviewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/analysisRiskOverviewHeader"
        android:layout_width="0dp"
        android:layout_height="@dimen/analysis_header_height"
        android:paddingStart="@dimen/analysis_header_side_padding"
        android:paddingEnd="@dimen/analysis_header_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/analysisRiskOverviewBack"
            android:layout_width="@dimen/analysis_back_button_size"
            android:layout_height="@dimen/analysis_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/analysis_risk_overview_back_content_description"
            android:padding="@dimen/analysis_back_icon_padding"
            android:src="@drawable/ic_upload_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/analysis_risk_overview_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/analysis_header_title_text_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="@dimen/analysis_back_button_size"
            android:layout_height="@dimen/analysis_back_button_size"
            android:contentDescription="@string/analysis_risk_overview_more_content_description"
            android:padding="@dimen/analysis_back_icon_padding"
            android:src="@drawable/ic_analysis_risk_overview_more"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/analysisRiskOverviewHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/analysis_risk_overview_content_side_padding"
            android:paddingTop="@dimen/analysis_risk_overview_content_top_padding"
            android:paddingEnd="@dimen/analysis_risk_overview_content_side_padding"
            android:paddingBottom="@dimen/analysis_risk_overview_content_bottom_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_risk_overview_primary_card_height"
                android:background="@drawable/bg_analysis_risk_overview_primary_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/analysis_risk_overview_primary_card_padding">

                <FrameLayout
                    android:layout_width="@dimen/analysis_risk_overview_score_size"
                    android:layout_height="@dimen/analysis_risk_overview_score_size">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_analysis_result_score_ring" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/analysisRiskOverviewScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/legal_lens_primary"
                            android:textSize="@dimen/analysis_risk_overview_score_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:text="@string/analysis_result_score_label"
                            android:textColor="@color/legal_lens_secondary_text"
                            android:textSize="@dimen/analysis_risk_overview_score_label_text_size" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/analysis_risk_overview_text_margin_start"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:text="@string/analysis_result_risk_heading"
                            android:textColor="@color/legal_lens_primary"
                            android:textSize="@dimen/analysis_result_risk_heading_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/analysis_risk_overview_badge_height"
                            android:layout_marginStart="@dimen/analysis_risk_overview_badge_margin_start"
                            android:background="@drawable/bg_analysis_risk_overview_medium_badge"
                            android:fontFamily="sans-serif"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="@dimen/analysis_risk_overview_badge_padding_horizontal"
                            android:paddingEnd="@dimen/analysis_risk_overview_badge_padding_horizontal"
                            android:text="@string/analysis_result_medium"
                            android:textColor="@color/contract_pending"
                            android:textSize="@dimen/analysis_risk_overview_badge_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/analysis_risk_overview_description_margin_top"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="@dimen/analysis_risk_overview_description_line_spacing"
                        android:text="@string/analysis_risk_overview_description"
                        android:textColor="@color/legal_lens_secondary_text"
                        android:textSize="@dimen/analysis_risk_overview_description_text_size" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_risk_overview_summary_height"
                android:layout_marginTop="@dimen/analysis_risk_overview_section_margin_top"
                android:background="@drawable/bg_analysis_result_card_large"
                android:orientation="vertical"
                android:padding="@dimen/analysis_risk_overview_summary_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="@string/analysis_risk_overview_summary_title"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/analysis_risk_overview_summary_title_text_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/analysis_risk_overview_summary_metric_height"
                    android:layout_marginTop="@dimen/analysis_risk_overview_summary_metrics_margin_top"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_analysis_risk_overview_high_summary"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/analysisRiskOverviewHighRiskCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/contract_risk_high"
                            android:textSize="@dimen/analysis_risk_overview_summary_metric_value_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/analysis_risk_overview_summary_metric_label_margin_top"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:text="@string/analysis_risk_overview_high_risk"
                            android:textColor="@color/contract_risk_high"
                            android:textSize="@dimen/analysis_risk_overview_summary_metric_label_text_size" />
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/analysis_risk_overview_summary_metric_spacing"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_analysis_risk_overview_medium_summary"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/analysisRiskOverviewMediumRiskCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/contract_pending"
                            android:textSize="@dimen/analysis_risk_overview_summary_metric_value_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/analysis_risk_overview_summary_metric_label_margin_top"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:text="@string/analysis_result_medium"
                            android:textColor="@color/contract_pending"
                            android:textSize="@dimen/analysis_risk_overview_summary_metric_label_text_size" />
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/analysis_risk_overview_summary_metric_spacing"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_analysis_risk_overview_low_summary"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/analysisRiskOverviewLowRiskCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="@color/contract_complete"
                            android:textSize="@dimen/analysis_risk_overview_summary_metric_value_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/analysis_risk_overview_summary_metric_label_margin_top"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:text="@string/analysis_risk_overview_low_risk"
                            android:textColor="@color/contract_complete"
                            android:textSize="@dimen/analysis_risk_overview_summary_metric_label_text_size" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_risk_overview_disclaimer_height"
                android:layout_marginTop="@dimen/analysis_risk_overview_section_margin_top"
                android:background="@drawable/bg_analysis_risk_overview_disclaimer"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="@dimen/analysis_risk_overview_disclaimer_padding">

                <ImageView
                    android:layout_width="@dimen/analysis_risk_overview_disclaimer_icon_size"
                    android:layout_height="@dimen/analysis_risk_overview_disclaimer_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_notification_info" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/analysis_risk_overview_disclaimer_text_margin_start"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/analysis_risk_overview_disclaimer_line_spacing"
                    android:text="@string/analysis_risk_overview_disclaimer"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/analysis_risk_overview_disclaimer_text_size" />
            </LinearLayout>

            <TextView
                android:id="@+id/analysisRiskOverviewViewDetails"
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_risk_overview_action_height"
                android:layout_marginTop="@dimen/analysis_risk_overview_section_margin_top"
                android:background="@drawable/bg_analysis_risk_overview_primary_action"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/analysis_risk_overview_view_details"
                android:textColor="@color/white"
                android:textSize="@dimen/analysis_risk_overview_action_text_size"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
