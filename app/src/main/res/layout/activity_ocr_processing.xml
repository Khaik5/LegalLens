<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ocr_processing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/upload_background">

    <LinearLayout
        android:id="@+id/ocr_processing_app_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/camera_permission_app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/camera_permission_side_padding"
        android:paddingEnd="@dimen/camera_permission_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ocr_processing_back"
            android:layout_width="@dimen/upload_back_button_size"
            android:layout_height="@dimen/upload_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/camera_permission_back_description"
            android:padding="@dimen/upload_back_icon_inset"
            android:src="@drawable/ic_upload_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/upload_title_margin_start"
            android:text="@string/ocr_processing_title"
            android:textColor="@color/upload_navy"
            android:textSize="@dimen/upload_title_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/ocr_processing_page_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/camera_permission_side_padding"
        android:layout_marginTop="@dimen/upload_content_top_padding"
        android:layout_marginEnd="@dimen/camera_permission_side_padding"
        android:textColor="@color/upload_body"
        android:textSize="@dimen/ocr_processing_body_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ocr_processing_app_bar" />

    <LinearLayout
        android:id="@+id/ocr_processing_upload_card"
        android:layout_width="0dp"
        android:layout_height="@dimen/ocr_processing_card_height"
        android:layout_marginStart="@dimen/camera_permission_side_padding"
        android:layout_marginTop="@dimen/upload_card_top_margin"
        android:layout_marginEnd="@dimen/camera_permission_side_padding"
        android:background="@drawable/bg_ocr_processing_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/upload_card_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ocr_processing_page_count">

        <ImageView
            android:layout_width="@dimen/ocr_processing_icon_size"
            android:layout_height="@dimen/ocr_processing_icon_size"
            android:src="@drawable/ic_camera_shield" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/upload_card_text_margin_start"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ocr_processing_upload_title"
                android:textColor="@color/upload_navy"
                android:textSize="@dimen/upload_card_description_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ocr_processing_upload_body"
                android:textColor="@color/upload_body"
                android:textSize="@dimen/ocr_processing_body_text_size" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ocr_processing_analysis_card"
        android:layout_width="0dp"
        android:layout_height="@dimen/ocr_processing_card_height"
        android:layout_marginStart="@dimen/camera_permission_side_padding"
        android:layout_marginTop="@dimen/upload_card_spacing"
        android:layout_marginEnd="@dimen/camera_permission_side_padding"
        android:background="@drawable/bg_ocr_processing_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/upload_card_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ocr_processing_upload_card">

        <ProgressBar
            android:layout_width="@dimen/ocr_processing_icon_size"
            android:layout_height="@dimen/ocr_processing_icon_size" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/upload_card_text_margin_start"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ocr_processing_analyzing_title"
                android:textColor="@color/upload_teal"
                android:textSize="@dimen/upload_card_description_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ocr_processing_analyzing_body"
                android:textColor="@color/upload_body"
                android:textSize="@dimen/ocr_processing_body_text_size" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="@dimen/ocr_processing_card_height"
        android:layout_marginStart="@dimen/camera_permission_side_padding"
        android:layout_marginTop="@dimen/upload_card_spacing"
        android:layout_marginEnd="@dimen/camera_permission_side_padding"
        android:background="@drawable/bg_ocr_processing_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/upload_card_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ocr_processing_analysis_card">

        <ImageView
            android:layout_width="@dimen/ocr_processing_icon_size"
            android:layout_height="@dimen/ocr_processing_icon_size"
            android:src="@drawable/ic_camera_permission" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/upload_card_text_margin_start"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ocr_processing_pending_title"
                android:textColor="@color/upload_body"
                android:textSize="@dimen/upload_card_description_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ocr_processing_pending_body"
                android:textColor="@color/upload_body"
                android:textSize="@dimen/ocr_processing_body_text_size" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
