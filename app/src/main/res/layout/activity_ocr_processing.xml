<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ocr_processing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/upload_background">

    <LinearLayout
        android:id="@+id/ocr_processing_app_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/camera_permission_app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ocr_processing_app_bar_side_padding"
        android:paddingEnd="@dimen/ocr_processing_app_bar_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ocr_processing_back"
            android:layout_width="@dimen/upload_back_button_size"
            android:layout_height="@dimen/upload_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/camera_permission_back_description"
            android:padding="@dimen/upload_back_icon_inset"
            android:src="@drawable/ic_upload_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/upload_title_margin_start"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="@string/ocr_processing_title"
            android:textColor="@color/upload_navy"
            android:textSize="@dimen/ocr_processing_title_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ocr_processing_document_card"
        android:layout_width="0dp"
        android:layout_height="@dimen/ocr_processing_document_card_height"
        android:layout_marginStart="@dimen/upload_content_side_padding"
        android:layout_marginTop="@dimen/ocr_processing_document_top_margin"
        android:layout_marginEnd="@dimen/upload_content_side_padding"
        android:background="@drawable/bg_ocr_processing_document_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/upload_card_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ocr_processing_app_bar">

        <ImageView
            android:layout_width="@dimen/ocr_processing_document_icon_container_size"
            android:layout_height="@dimen/ocr_processing_document_icon_container_size"
            android:background="@drawable/bg_ocr_processing_document_icon"
            android:padding="@dimen/ocr_processing_document_icon_padding"
            android:src="@drawable/ic_upload_pdf" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ocr_processing_document_text_margin_start"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ocr_processing_document_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/upload_navy"
                android:textSize="@dimen/ocr_processing_timeline_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ocr_processing_document_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ocr_processing_document_details_margin_top"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/upload_body"
                android:textSize="@dimen/ocr_processing_body_text_size" />
        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ocr_processing_timeline"
        android:layout_width="0dp"
        android:layout_height="@dimen/ocr_processing_timeline_height"
        android:layout_marginStart="@dimen/ocr_processing_timeline_side_padding"
        android:layout_marginTop="@dimen/ocr_processing_timeline_top_margin"
        android:layout_marginEnd="@dimen/ocr_processing_timeline_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ocr_processing_document_card">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ocr_processing_upload_step"
            android:layout_width="0dp"
            android:layout_height="@dimen/ocr_processing_timeline_step_height"
            android:layout_marginTop="@dimen/ocr_processing_timeline_top_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/ocr_processing_upload_connector"
                android:layout_width="@dimen/ocr_processing_timeline_connector_width"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/ocr_processing_timeline_connector_start_margin"
                android:background="@color/camera_scan_ready"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ocr_processing_upload_indicator" />

            <View
                android:id="@+id/ocr_processing_upload_indicator"
                android:layout_width="@dimen/ocr_processing_timeline_indicator_size"
                android:layout_height="@dimen/ocr_processing_timeline_indicator_size"
                android:background="@drawable/bg_ocr_processing_completed_indicator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="@dimen/ocr_processing_check_icon_size"
                android:layout_height="@dimen/ocr_processing_check_icon_size"
                android:src="@drawable/ic_ocr_processing_check"
                app:layout_constraintBottom_toBottomOf="@id/ocr_processing_upload_indicator"
                app:layout_constraintEnd_toEndOf="@id/ocr_processing_upload_indicator"
                app:layout_constraintStart_toStartOf="@id/ocr_processing_upload_indicator"
                app:layout_constraintTop_toTopOf="@id/ocr_processing_upload_indicator" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ocr_processing_timeline_content_margin_start"
                android:layout_marginTop="@dimen/ocr_processing_timeline_title_top_margin"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/ocr_processing_upload_title"
                    android:textColor="@color/upload_navy"
                    android:textSize="@dimen/ocr_processing_timeline_title_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ocr_processing_timeline_body_margin_top"
                    android:text="@string/ocr_processing_upload_body"
                    android:textColor="@color/upload_body"
                    android:textSize="@dimen/ocr_processing_body_text_size" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ocr_processing_analysis_step"
            android:layout_width="0dp"
            android:layout_height="@dimen/ocr_processing_timeline_step_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ocr_processing_upload_step">

            <View
                android:id="@+id/ocr_processing_analysis_connector"
                android:layout_width="@dimen/ocr_processing_timeline_connector_width"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/ocr_processing_timeline_connector_start_margin"
                android:background="@color/upload_border"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ocr_processing_analysis_indicator" />

            <View
                android:id="@+id/ocr_processing_analysis_indicator"
                android:layout_width="@dimen/ocr_processing_timeline_indicator_size"
                android:layout_height="@dimen/ocr_processing_timeline_indicator_size"
                android:background="@drawable/bg_ocr_processing_active_indicator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="@dimen/ocr_processing_active_dot_size"
                android:layout_height="@dimen/ocr_processing_active_dot_size"
                android:background="@drawable/bg_ocr_processing_active_dot"
                app:layout_constraintBottom_toBottomOf="@id/ocr_processing_analysis_indicator"
                app:layout_constraintEnd_toEndOf="@id/ocr_processing_analysis_indicator"
                app:layout_constraintStart_toStartOf="@id/ocr_processing_analysis_indicator"
                app:layout_constraintTop_toTopOf="@id/ocr_processing_analysis_indicator" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ocr_processing_timeline_content_margin_start"
                android:layout_marginTop="@dimen/ocr_processing_timeline_title_top_margin"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/ocr_processing_analyzing_title"
                    android:textColor="@color/upload_teal"
                    android:textSize="@dimen/ocr_processing_timeline_title_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ocr_processing_timeline_body_margin_top"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/ocr_processing_analyzing_body"
                    android:textColor="@color/upload_teal"
                    android:textSize="@dimen/ocr_processing_body_text_size" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ocr_processing_text_step"
            android:layout_width="0dp"
            android:layout_height="@dimen/ocr_processing_timeline_step_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ocr_processing_analysis_step">

            <View
                android:id="@+id/ocr_processing_text_connector"
                android:layout_width="@dimen/ocr_processing_timeline_connector_width"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/ocr_processing_timeline_connector_start_margin"
                android:background="@color/upload_border"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ocr_processing_text_indicator" />

            <TextView
                android:id="@+id/ocr_processing_text_indicator"
                android:layout_width="@dimen/ocr_processing_timeline_indicator_size"
                android:layout_height="@dimen/ocr_processing_timeline_indicator_size"
                android:background="@drawable/bg_ocr_processing_pending_indicator"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/ocr_processing_text_step_number"
                android:textColor="@color/upload_body"
                android:textSize="@dimen/ocr_processing_step_number_text_size"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ocr_processing_timeline_content_margin_start"
                android:layout_marginTop="@dimen/ocr_processing_timeline_title_top_margin"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/ocr_processing_pending_title"
                    android:textColor="@color/upload_body"
                    android:textSize="@dimen/ocr_processing_timeline_title_text_size" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ocr_processing_timeline_body_margin_top"
                    android:text="@string/ocr_processing_pending_body"
                    android:textColor="@color/upload_body"
                    android:textSize="@dimen/ocr_processing_body_text_size" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/ocr_processing_timeline_final_step_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ocr_processing_text_step">

            <TextView
                android:id="@+id/ocr_processing_review_indicator"
                android:layout_width="@dimen/ocr_processing_timeline_indicator_size"
                android:layout_height="@dimen/ocr_processing_timeline_indicator_size"
                android:background="@drawable/bg_ocr_processing_pending_indicator"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/ocr_processing_review_step_number"
                android:textColor="@color/upload_body"
                android:textSize="@dimen/ocr_processing_step_number_text_size"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ocr_processing_timeline_content_margin_start"
                android:layout_marginTop="@dimen/ocr_processing_timeline_title_top_margin"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/ocr_processing_review_title"
                    android:textColor="@color/upload_body"
                    android:textSize="@dimen/ocr_processing_timeline_title_text_size" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ocr_processing_timeline_body_margin_top"
                    android:text="@string/ocr_processing_pending_body"
                    android:textColor="@color/upload_body"
                    android:textSize="@dimen/ocr_processing_body_text_size" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ocr_processing_footer"
        android:layout_width="0dp"
        android:layout_height="@dimen/ocr_processing_footer_height"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/ocr_processing_footer_top_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ocr_processing_timeline">

        <LinearLayout
            android:layout_width="@dimen/ocr_processing_footer_dots_width"
            android:layout_height="@dimen/ocr_processing_footer_dot_size"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/ocr_processing_footer_dot_size"
                android:layout_height="@dimen/ocr_processing_footer_dot_size"
                android:background="@drawable/bg_ocr_processing_footer_dot_active" />

            <View
                android:layout_width="@dimen/ocr_processing_footer_dot_spacing"
                android:layout_height="@dimen/ocr_processing_footer_dot_size" />

            <View
                android:layout_width="@dimen/ocr_processing_footer_dot_size"
                android:layout_height="@dimen/ocr_processing_footer_dot_size"
                android:background="@drawable/bg_ocr_processing_footer_dot_middle" />

            <View
                android:layout_width="@dimen/ocr_processing_footer_dot_spacing"
                android:layout_height="@dimen/ocr_processing_footer_dot_size" />

            <View
                android:layout_width="@dimen/ocr_processing_footer_dot_size"
                android:layout_height="@dimen/ocr_processing_footer_dot_size"
                android:background="@drawable/bg_ocr_processing_footer_dot_pending" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ocr_processing_footer_notice_margin_top"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.092"
            android:text="@string/ocr_processing_notice"
            android:textColor="@color/upload_body"
            android:textSize="@dimen/ocr_processing_body_text_size" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
