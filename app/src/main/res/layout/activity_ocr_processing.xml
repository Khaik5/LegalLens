<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ocr_processing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/upload_background">

    <LinearLayout
        android:id="@+id/ocr_processing_app_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/camera_permission_app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ocr_processing_app_bar_side_padding"
        android:paddingEnd="@dimen/ocr_processing_app_bar_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ocr_processing_back"
            android:layout_width="@dimen/upload_back_button_size"
            android:layout_height="@dimen/upload_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/camera_permission_back_description"
            android:padding="@dimen/upload_back_icon_inset"
            android:src="@drawable/ic_upload_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/upload_title_margin_start"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="@string/ocr_processing_title"
            android:textColor="@color/upload_navy"
            android:textSize="@dimen/ocr_processing_title_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ocr_processing_document_card"
        android:layout_width="0dp"
        android:layout_height="@dimen/ocr_processing_document_card_height"
        android:layout_marginStart="@dimen/upload_content_side_padding"
        android:layout_marginTop="@dimen/ocr_processing_document_top_margin"
        android:layout_marginEnd="@dimen/upload_content_side_padding"
        android:background="@drawable/bg_ocr_processing_document_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/upload_card_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ocr_processing_app_bar">

        <ImageView
            android:layout_width="@dimen/ocr_processing_document_icon_container_size"
            android:layout_height="@dimen/ocr_processing_document_icon_container_size"
            android:background="@drawable/bg_ocr_processing_document_icon"
            android:padding="@dimen/ocr_processing_document_icon_padding"
            android:src="@drawable/ic_upload_pdf" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ocr_processing_document_text_margin_start"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ocr_processing_document_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/upload_navy"
                android:textSize="@dimen/ocr_processing_timeline_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ocr_processing_document_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ocr_processing_document_details_margin_top"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/upload_body"
                android:textSize="@dimen/ocr_processing_body_text_size" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ocr_processing_timeline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/analysis_processing_timeline_side_padding"
        android:layout_marginTop="@dimen/analysis_processing_timeline_margin_top"
        android:layout_marginEnd="@dimen/analysis_processing_timeline_side_padding"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/ocr_processing_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ocr_processing_document_card" />

    <LinearLayout
        android:id="@+id/ocr_processing_footer"
        android:layout_width="0dp"
        android:layout_height="@dimen/ocr_processing_footer_height"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/ocr_processing_footer_top_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="@dimen/ocr_processing_footer_dots_width"
            android:layout_height="@dimen/ocr_processing_footer_dot_size"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/ocr_processing_footer_dot_size"
                android:layout_height="@dimen/ocr_processing_footer_dot_size"
                android:background="@drawable/bg_ocr_processing_footer_dot_active" />

            <View
                android:layout_width="@dimen/ocr_processing_footer_dot_spacing"
                android:layout_height="@dimen/ocr_processing_footer_dot_size" />

            <View
                android:layout_width="@dimen/ocr_processing_footer_dot_size"
                android:layout_height="@dimen/ocr_processing_footer_dot_size"
                android:background="@drawable/bg_ocr_processing_footer_dot_middle" />

            <View
                android:layout_width="@dimen/ocr_processing_footer_dot_spacing"
                android:layout_height="@dimen/ocr_processing_footer_dot_size" />

            <View
                android:layout_width="@dimen/ocr_processing_footer_dot_size"
                android:layout_height="@dimen/ocr_processing_footer_dot_size"
                android:background="@drawable/bg_ocr_processing_footer_dot_pending" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ocr_processing_footer_notice_margin_top"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.092"
            android:text="@string/ocr_processing_notice"
            android:textColor="@color/upload_body"
            android:textSize="@dimen/ocr_processing_body_text_size" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
