<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/analysis_summary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background">

    <LinearLayout
        android:id="@+id/analysis_summary_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/analysis_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/analysis_header_side_padding"
        android:paddingEnd="@dimen/analysis_header_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/analysis_summary_back"
            android:layout_width="@dimen/analysis_back_button_size"
            android:layout_height="@dimen/analysis_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/analysis_summary_back_content_description"
            android:padding="@dimen/analysis_back_icon_padding"
            android:src="@drawable/ic_upload_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/analysis_header_title_margin_start"
            android:layout_weight="1"
            android:text="@string/analysis_summary_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/analysis_header_title_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/analysis_summary_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/analysis_summary_content_side_padding"
            android:paddingTop="@dimen/analysis_summary_content_padding_vertical"
            android:paddingEnd="@dimen/analysis_summary_content_side_padding"
            android:paddingBottom="@dimen/analysis_summary_content_padding_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_document_card_height"
                android:background="@drawable/bg_analysis_summary_section"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/analysis_document_card_padding"
                android:paddingEnd="@dimen/analysis_document_card_padding">

                <FrameLayout
                    android:layout_width="@dimen/analysis_document_icon_size"
                    android:layout_height="@dimen/analysis_document_icon_size"
                    android:background="@drawable/bg_analysis_summary_document_icon">

                    <ImageView
                        android:layout_width="@dimen/analysis_document_icon_art_size"
                        android:layout_height="@dimen/analysis_document_icon_art_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ocr_saved_document" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/analysis_document_text_margin_start"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/analysis_summary_document_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/legal_lens_primary"
                        android:textSize="@dimen/analysis_document_name_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/analysis_summary_document_metadata"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/analysis_document_metadata_margin_top"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/legal_lens_secondary_text"
                        android:textSize="@dimen/analysis_document_metadata_text_size" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_summary_category_height"
                android:layout_marginTop="@dimen/analysis_summary_element_spacing"
                android:background="@drawable/bg_analysis_summary_category"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12">

                <ImageView
                    android:layout_width="@dimen/analysis_summary_category_icon_size"
                    android:layout_height="@dimen/analysis_summary_category_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ocr_saved_document" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:text="@string/analysis_summary_category"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/analysis_summary_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/analysis_summary_element_spacing"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/analysis_summary_important_information"
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_action_height"
                android:layout_marginTop="@dimen/analysis_summary_element_spacing"
                android:background="@drawable/bg_analysis_primary_action"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/analysis_summary_important_information"
                android:textColor="@color/ocr_saved_white"
                android:textSize="@dimen/analysis_action_text_size"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
