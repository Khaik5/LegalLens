<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/analysis_clause_source_sheet_height"
    android:background="@drawable/bg_contract_filter_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_4"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_12"
        android:background="@drawable/bg_contract_filter_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_58"
        android:layout_marginTop="@dimen/dp_4"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/analysis_clause_source_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/analysis_clause_source_close_icon"
            android:layout_width="@dimen/dp_26"
            android:layout_height="@dimen/dp_26"
            android:background="@drawable/bg_analysis_clause_source_close"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/dp_11"
                android:layout_height="@dimen/dp_11"
                android:layout_gravity="center"
                android:contentDescription="@string/analysis_clause_source_close"
                android:src="@drawable/ic_analysis_clause_source_close" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:background="@color/legal_lens_input_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_24"
        android:paddingTop="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24">

        <TextView
            android:id="@+id/analysis_clause_source_reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_analysis_key_facts_reference"
            android:paddingStart="@dimen/dp_8"
            android:paddingTop="@dimen/dp_2"
            android:paddingEnd="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_2"
            android:textColor="@color/legal_lens_auth_accent"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/analysis_clause_source_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_24"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:text="@string/analysis_clause_source_subtitle"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_14" />

        <TextView
            android:id="@+id/analysis_clause_source_excerpt"
            android:layout_width="match_parent"
            android:layout_height="@dimen/analysis_clause_source_excerpt_card_height"
            android:layout_marginTop="@dimen/dp_20"
            android:background="@drawable/bg_analysis_summary_section"
            android:gravity="top"
            android:lineSpacingExtra="@dimen/dp_4"
            android:padding="@dimen/dp_16"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_14" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            android:layout_marginTop="@dimen/dp_20"
            android:background="@drawable/bg_analysis_summary_category"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12">

            <ImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:contentDescription="@null"
                android:src="@drawable/ic_analysis_clause_source_info" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_weight="1"
                android:lineSpacingExtra="@dimen/dp_4"
                android:text="@string/analysis_clause_source_notice"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_14" />
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/analysis_clause_source_close_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"
        android:layout_marginBottom="@dimen/dp_24"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_analysis_primary_action"
        android:gravity="center"
        android:text="@string/analysis_clause_source_close"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold" />
</LinearLayout>
