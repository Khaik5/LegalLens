<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="@dimen/dp_80"
    android:layout_marginEnd="@dimen/dp_6"
    android:layout_weight="1"
    android:background="@drawable/bg_dashboard_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/dp_12">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/dashboard_total_contracts"
        android:textColor="@color/dashboard_primary_text"
        android:textSize="@dimen/sp_22"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:includeFontPadding="false"
        android:text="@string/dashboard_contracts_label"
        android:textColor="@color/dashboard_secondary_text"
        android:textSize="@dimen/sp_11" />
</LinearLayout>
