<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"
        android:background="@drawable/bg_unlock_success_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:background="@drawable/bg_credit_success_outer">

            <FrameLayout
                android:layout_width="@dimen/dp_64"
                android:layout_height="@dimen/dp_64"
                android:layout_gravity="center"
                android:background="@drawable/bg_success_inner_seal">

                <ImageView
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_credit_success_check" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/unlock_success_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_22"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/unlock_success_description"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_14" />

        <Button
            android:id="@+id/unlockSuccessViewResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/dp_54"
            android:layout_marginTop="@dimen/dp_20"
            android:background="@drawable/bg_unlock_confirmation_primary_action"
            android:backgroundTint="@null"
            android:includeFontPadding="false"
            android:minWidth="@dimen/dp_0"
            android:text="@string/unlock_success_view_result"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
