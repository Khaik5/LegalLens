<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_language_sheet"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_24">
        <View
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_4"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@color/profile_toggle_off" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:fontFamily="@font/manrope"
            android:text="@string/draft_save_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:fontFamily="@font/manrope"
            android:text="@string/draft_save_selected_version"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_13"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:fontFamily="@font/manrope"
            android:text="@string/draft_save_name_label"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/saveDraftName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_64"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_contract_rename_input"
            android:fontFamily="@font/manrope"
            android:hint="@string/draft_save_name_label"
            android:inputType="textCapSentences"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            android:singleLine="true"
            android:text="@string/draft_save_default_name"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_14" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:background="@drawable/bg_compare_notice"
            android:drawableStart="@drawable/ic_credit_low_info"
            android:drawablePadding="@dimen/dp_8"
            android:fontFamily="@font/manrope"
            android:gravity="center_vertical"
            android:padding="@dimen/dp_12"
            android:text="@string/draft_save_copy_notice"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_12" />
        <LinearLayout
            android:id="@+id/saveDraftForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_draft_warning"
                android:drawableStart="@drawable/ic_chatbot_error"
                android:drawablePadding="@dimen/dp_8"
                android:fontFamily="@font/manrope"
                android:gravity="center_vertical"
                android:padding="@dimen/dp_12"
                android:text="@string/draft_save_legal_warning"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_12" />
            <CheckBox
                android:id="@+id/saveDraftAcknowledge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:buttonTint="@color/legal_lens_auth_accent"
                android:fontFamily="@font/manrope"
                android:text="@string/draft_save_acknowledge"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/sp_12" />
            <TextView
                android:id="@+id/saveDraftConfirm"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_primary_action"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/draft_save_action"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/saveDraftCancel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/bg_contract_search_result"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/draft_save_back"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/saveDraftLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/dp_20"
            android:visibility="gone">
            <ProgressBar android:layout_width="@dimen/dp_40" android:layout_height="@dimen/dp_40" android:indeterminateTint="@color/legal_lens_auth_accent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_save_loading_title" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_16" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_save_loading_body" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_13" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_chatbot_draft_warning" android:padding="@dimen/dp_12" android:text="@string/draft_save_legal_warning" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/saveDraftError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope" android:text="@string/draft_save_error_title" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_16" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:fontFamily="@font/manrope" android:text="@string/draft_save_error_body" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_13" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_chatbot_draft_warning" android:padding="@dimen/dp_12" android:text="@string/draft_save_error_note" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
            <TextView android:id="@+id/saveDraftRetry" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_chatbot_primary_action" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_save_retry" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/saveDraftReturn" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_save_back_unsaved" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/saveDraftSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_save_success_title" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_16" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_save_success_body" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_13" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_chatbot_draft_warning" android:padding="@dimen/dp_12" android:text="@string/draft_save_legal_warning" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
            <TextView android:id="@+id/saveDraftViewSaved" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_chatbot_primary_action" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_save_view_saved" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/saveDraftExportPdf" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_save_export_pdf" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
