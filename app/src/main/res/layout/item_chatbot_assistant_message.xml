<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/chatbot_message_row_spacing">

    <TextView
        android:id="@+id/chatbotAssistantAvatar"
        android:layout_width="@dimen/chatbot_avatar_size"
        android:layout_height="@dimen/chatbot_avatar_size"
        android:background="@drawable/bg_chatbot_avatar"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/chatbot_avatar_initials"
        android:textColor="@color/white"
        android:textSize="@dimen/chatbot_avatar_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/chatbotAssistantMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chatbot_avatar_gap"
        android:layout_marginEnd="@dimen/chatbot_assistant_end_margin"
        android:background="@drawable/bg_chatbot_assistant_message"
        android:fontFamily="@font/manrope"
        android:includeFontPadding="false"
        android:lineSpacingExtra="@dimen/chatbot_message_line_spacing"
        android:padding="@dimen/chatbot_message_padding"
        android:textColor="@color/legal_lens_status_text"
        android:textSize="@dimen/chatbot_message_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/chatbotAssistantAvatar"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView android:fontFamily="@font/manrope"
        android:id="@+id/chatbotDraftNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_12"
        android:background="@drawable/bg_chatbot_draft_warning"
        android:drawableStart="@drawable/ic_alert_triangle"
        android:drawablePadding="@dimen/dp_8"
        android:drawableTint="@color/chatbot_draft_notice_icon"
        android:gravity="center_vertical"
        android:padding="@dimen/dp_12"
        android:text="@string/chatbot_draft_check_notice"
        android:textColor="@color/legal_lens_secondary_text"
        android:textSize="@dimen/sp_12"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/chatbotAssistantMessage"
        app:layout_constraintEnd_toEndOf="@id/chatbotAssistantMessage"
        app:layout_constraintTop_toBottomOf="@id/chatbotAssistantMessage" />
</androidx.constraintlayout.widget.ConstraintLayout>
