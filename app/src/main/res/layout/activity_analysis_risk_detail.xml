<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/analysisRiskDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/analysisRiskDetailHeader"
        android:layout_width="0dp"
        android:layout_height="@dimen/analysis_header_height"
        android:paddingStart="@dimen/analysis_header_side_padding"
        android:paddingEnd="@dimen/analysis_header_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/analysisRiskDetailBack"
            android:layout_width="@dimen/analysis_back_button_size"
            android:layout_height="@dimen/analysis_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/analysis_risk_detail_back_content_description"
            android:padding="@dimen/analysis_back_icon_padding"
            android:src="@drawable/ic_upload_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/analysisRiskDetailHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/analysis_risk_detail_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/analysis_header_title_text_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="@dimen/analysis_back_button_size"
            android:layout_height="@dimen/analysis_back_button_size"
            android:contentDescription="@string/analysis_risk_detail_more_content_description"
            android:padding="@dimen/analysis_back_icon_padding"
            android:src="@drawable/ic_analysis_risk_overview_more"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/analysisRiskDetailHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/analysis_risk_overview_content_side_padding"
            android:paddingTop="@dimen/analysis_risk_overview_content_top_padding"
            android:paddingEnd="@dimen/analysis_risk_overview_content_side_padding"
            android:paddingBottom="@dimen/analysis_risk_overview_content_bottom_padding">

            <TextView
                android:id="@+id/analysisRiskDetailSeverity"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_24"
                android:background="@drawable/bg_analysis_risk_findings_high_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/dp_10"
                android:paddingEnd="@dimen/dp_10"
                android:textColor="@color/contract_risk_high"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analysisRiskDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/analysis_risk_detail_section_margin_top"
                android:includeFontPadding="false"
                android:letterSpacing="0.07"
                android:text="@string/analysis_risk_detail_attention_heading"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analysisRiskDetailAttentionReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/dp_2"
                android:textColor="@color/legal_lens_status_text"
                android:textSize="@dimen/sp_14" />

            <TextView
                android:id="@+id/analysisRiskDetailClauseHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/analysis_risk_detail_section_margin_top"
                android:includeFontPadding="false"
                android:letterSpacing="0.07"
                android:text="@string/analysis_risk_detail_clause_heading"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:background="@drawable/bg_analysis_risk_detail_quote"
                android:orientation="vertical"
                android:padding="@dimen/dp_14">

                <TextView
                    android:id="@+id/analysisRiskDetailClauseReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/analysis_risk_detail_clause_reference"
                    android:textColor="@color/contract_pending"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/analysisRiskDetailClauseExcerpt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:textColor="@color/legal_lens_status_text"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

            <TextView
                android:id="@+id/analysisRiskDetailLegalHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/analysis_risk_detail_section_margin_top"
                android:includeFontPadding="false"
                android:letterSpacing="0.07"
                android:text="@string/analysis_risk_detail_legal_explanation_heading"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analysisRiskDetailLegalExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/dp_2"
                android:textColor="@color/legal_lens_status_text"
                android:textSize="@dimen/sp_14" />

            <LinearLayout
                android:id="@+id/analysisRiskDetailLegalReference"
                android:layout_width="match_parent"
                android:layout_height="@dimen/analysis_risk_detail_legal_reference_height"
                android:layout_marginTop="@dimen/analysis_risk_detail_section_margin_top"
                android:background="@drawable/bg_analysis_risk_detail_legal_reference"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_14">

                <FrameLayout
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:background="@drawable/bg_analysis_key_facts_reference">

                    <ImageView
                        android:layout_width="@dimen/analysis_result_item_icon_size"
                        android:layout_height="@dimen/analysis_result_item_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_analysis_result_book" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/analysisRiskDetailLegalReferenceTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/legal_lens_primary"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/analysisRiskDetailLegalReferenceSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:includeFontPadding="false"
                        android:textColor="@color/legal_lens_secondary_text"
                        android:textSize="@dimen/sp_11" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_analysis_risk_findings_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/analysisRiskDetailRecommendationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/analysis_risk_detail_section_margin_top"
                android:background="@drawable/bg_analysis_risk_detail_recommendation"
                android:orientation="vertical"
                android:padding="@dimen/dp_14">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/analysis_risk_detail_recommendation_heading"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/analysisRiskDetailRecommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
