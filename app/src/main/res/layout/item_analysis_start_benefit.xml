<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/analysis_benefit_card_height"
    android:background="@drawable/bg_analysis_benefit_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/analysis_benefit_card_padding"
    android:paddingEnd="@dimen/analysis_benefit_card_padding">

    <TextView
        android:id="@+id/analysis_start_benefit_step"
        android:layout_width="@dimen/analysis_step_badge_size"
        android:layout_height="@dimen/analysis_step_badge_size"
        android:background="@drawable/bg_analysis_step_badge"
        android:gravity="center"
        android:textColor="@color/ocr_saved_teal"
        android:textSize="@dimen/analysis_step_text_size"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/analysis_benefit_text_margin_start"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/analysis_start_benefit_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ocr_saved_navy"
            android:textSize="@dimen/analysis_benefit_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/analysis_start_benefit_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/analysis_benefit_description_margin_top"
            android:lineSpacingExtra="@dimen/analysis_benefit_description_line_spacing"
            android:textColor="@color/ocr_saved_body"
            android:textSize="@dimen/analysis_benefit_description_text_size" />
    </LinearLayout>
</LinearLayout>
