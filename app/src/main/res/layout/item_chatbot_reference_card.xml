<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatbotReferenceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/chatbot_reference_card_min_height"
    android:background="@drawable/bg_chatbot_reference_card"
    android:padding="@dimen/chatbot_reference_card_padding">

    <TextView
        android:id="@+id/chatbotReferenceTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/legal_lens_primary"
        android:textSize="@dimen/chatbot_reference_title_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/chatbotReferenceChevron"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/chatbotReferenceChevron"
        android:layout_width="@dimen/chatbot_reference_chevron_size"
        android:layout_height="@dimen/chatbot_reference_chevron_size"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_down"
        app:tint="@color/legal_lens_secondary_text"
        app:layout_constraintBottom_toBottomOf="@id/chatbotReferenceTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/chatbotReferenceTitle" />

    <TextView
        android:id="@+id/chatbotReferenceExcerpt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/chatbot_reference_excerpt_margin_top"
        android:fontFamily="@font/manrope"
        android:includeFontPadding="false"
        android:lineSpacingExtra="@dimen/chatbot_reference_excerpt_line_spacing"
        android:maxLines="2"
        android:textColor="@color/legal_lens_secondary_text"
        android:textSize="@dimen/chatbot_reference_excerpt_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatbotReferenceTitle" />
</androidx.constraintlayout.widget.ConstraintLayout>
