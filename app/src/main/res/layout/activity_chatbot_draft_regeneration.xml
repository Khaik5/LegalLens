<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12">

        <ImageButton
            android:id="@+id/draftRegenerationBack"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_draft_back"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_contract_search_back" />

        <TextView
            android:id="@+id/draftRegenerationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_weight="1"
            android:fontFamily="@font/manrope"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold" />

        <ImageButton
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_draft_more"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_analysis_risk_overview_more" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_16"
        android:background="@drawable/bg_chatbot_source_document"
        android:orientation="vertical"
        android:padding="@dimen/dp_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:background="@drawable/bg_chatbot_generation_progress"
                android:contentDescription="@null"
                android:padding="@dimen/dp_10"
                android:src="@drawable/ic_contract_search_document"
                app:tint="@color/legal_lens_auth_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/draftRegenerationSourceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/draftRegenerationSourceMetadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:fontFamily="@font/manrope"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/draftRegenerationSourceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/bg_chatbot_source_badge"
            android:fontFamily="@font/manrope"
            android:paddingStart="@dimen/dp_8"
            android:paddingTop="@dimen/dp_4"
            android:paddingEnd="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_4"
            android:textColor="@color/legal_lens_auth_accent"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16">

        <LinearLayout
            android:id="@+id/draftRegenerationLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_24">

            <FrameLayout
                android:layout_width="@dimen/dp_88"
                android:layout_height="@dimen/dp_88"
                android:background="@drawable/bg_chatbot_generation_progress">

                <ProgressBar
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/legal_lens_auth_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/chatbot_draft_regeneration_loading_title"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/dp_4"
                android:text="@string/chatbot_draft_regeneration_loading_body"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_14" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                android:background="@drawable/bg_chatbot_draft_warning"
                android:drawableStart="@drawable/ic_alert_triangle"
                android:drawablePadding="@dimen/dp_8"
                android:drawableTint="@color/chatbot_draft_notice_icon"
                android:fontFamily="@font/manrope"
                android:gravity="center_vertical"
                android:lineSpacingExtra="@dimen/dp_4"
                android:padding="@dimen/dp_12"
                android:text="@string/chatbot_draft_missing_warning"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/draftRegenerationError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_24"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/dp_88"
                android:layout_height="@dimen/dp_88"
                android:background="@color/legal_lens_error_background">

                <ImageView
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alert_triangle"
                    app:tint="@color/legal_lens_error" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/chatbot_draft_regeneration_error_title"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/dp_4"
                android:text="@string/chatbot_draft_regeneration_error_body"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_14" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:background="@color/legal_lens_error_background"
                android:drawableStart="@drawable/ic_alert_triangle"
                android:drawablePadding="@dimen/dp_8"
                android:drawableTint="@color/legal_lens_error"
                android:fontFamily="@font/manrope"
                android:gravity="center_vertical"
                android:lineSpacingExtra="@dimen/dp_4"
                android:padding="@dimen/dp_12"
                android:text="@string/chatbot_draft_regeneration_error_note"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/draftRegenerationSuccess"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_16"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/dp_88"
                android:layout_height="@dimen/dp_88"
                android:background="@color/legal_lens_auth_icon_background">

                <ImageView
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_credit_success_check"
                    app:tint="@color/legal_lens_auth_accent" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/chatbot_draft_regeneration_success_title"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/dp_4"
                android:text="@string/chatbot_draft_regeneration_success_body"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:background="@drawable/bg_chatbot_source_document"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:text="@string/chatbot_draft_regeneration_result_name"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@drawable/bg_chatbot_source_badge"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="@dimen/dp_8"
                    android:paddingTop="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_4"
                    android:text="@string/chatbot_draft_regeneration_result_badge"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_draft_warning"
                android:drawableStart="@drawable/ic_alert_triangle"
                android:drawablePadding="@dimen/dp_8"
                android:drawableTint="@color/chatbot_draft_notice_icon"
                android:fontFamily="@font/manrope"
                android:gravity="center_vertical"
                android:lineSpacingExtra="@dimen/dp_4"
                android:padding="@dimen/dp_12"
                android:text="@string/chatbot_draft_missing_warning"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/legal_lens_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_12">

        <TextView
            android:id="@+id/draftRegenerationPendingAction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:background="@drawable/bg_chatbot_draft_pending_action"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_regeneration_pending_action"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/draftRegenerationRetry"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:background="@drawable/bg_chatbot_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_regeneration_retry"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/draftRegenerationView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:background="@drawable/bg_chatbot_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_regeneration_view"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/draftRegenerationReturn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_chatbot_new_state_suggestion"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_return_to_source"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
