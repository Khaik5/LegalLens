<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/chatbot_message_row_spacing">

    <TextView
        android:id="@+id/chatbotAssistantCitationAvatar"
        android:layout_width="@dimen/chatbot_avatar_size"
        android:layout_height="@dimen/chatbot_avatar_size"
        android:background="@drawable/bg_chatbot_avatar"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/chatbot_avatar_initials"
        android:textColor="@color/white"
        android:textSize="@dimen/chatbot_avatar_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/chatbotAssistantCitationBubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chatbot_avatar_gap"
        android:layout_marginEnd="@dimen/chatbot_citation_assistant_end_margin"
        android:background="@drawable/bg_chatbot_assistant_message"
        android:orientation="vertical"
        android:padding="@dimen/chatbot_message_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/chatbotAssistantCitationAvatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/chatbotAssistantCitationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/chatbot_message_line_spacing"
            android:textColor="@color/legal_lens_status_text"
            android:textSize="@dimen/chatbot_message_text_size" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chatbotCitationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chatbot_citation_card_margin_top"
            android:background="@drawable/bg_analysis_risk_detail_legal_reference"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="@dimen/chatbot_citation_card_padding">

            <ImageView
                android:id="@+id/chatbotCitationIcon"
                android:layout_width="@dimen/chatbot_citation_icon_size"
                android:layout_height="@dimen/chatbot_citation_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_ocr_saved_document"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/legal_lens_auth_accent" />

            <TextView
                android:id="@+id/chatbotCitationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chatbot_citation_title_margin_start"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/chatbot_citation_title_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/chatbotCitationIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/chatbotCitationIcon"
                app:layout_constraintTop_toTopOf="@id/chatbotCitationIcon" />

            <TextView
                android:id="@+id/chatbotCitationDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chatbot_citation_description_margin_top"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/chatbot_citation_description_line_spacing"
                android:maxLines="2"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/chatbot_citation_description_text_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chatbotCitationIcon" />

            <TextView
                android:id="@+id/chatbotCitationAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chatbot_citation_action_margin_top"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/chatbot_citation_action_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chatbotCitationDescription" />

            <ImageView
                android:layout_width="@dimen/chatbot_citation_chevron_size"
                android:layout_height="@dimen/chatbot_citation_chevron_size"
                android:layout_marginStart="@dimen/chatbot_citation_chevron_margin_start"
                android:contentDescription="@null"
                android:src="@drawable/ic_analysis_risk_findings_chevron_right"
                app:layout_constraintBottom_toBottomOf="@id/chatbotCitationAction"
                app:layout_constraintStart_toEndOf="@id/chatbotCitationAction"
                app:layout_constraintTop_toTopOf="@id/chatbotCitationAction" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
