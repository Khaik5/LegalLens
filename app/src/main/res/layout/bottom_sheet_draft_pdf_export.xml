<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_profile_language_sheet" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/dp_24" android:paddingEnd="@dimen/dp_24" android:paddingBottom="@dimen/dp_24">
        <View android:layout_width="@dimen/dp_40" android:layout_height="@dimen/dp_4" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/dp_8" android:background="@color/profile_toggle_off" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_20" android:fontFamily="@font/manrope" android:text="@string/draft_pdf_title" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_20" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="@dimen/dp_40" android:layout_height="@dimen/dp_40" android:background="@drawable/bg_compare_notice" android:contentDescription="@null" android:padding="@dimen/dp_8" android:src="@drawable/ic_contract_search_document" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dp_12" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/pdfDocumentTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_14" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_4" android:fontFamily="@font/manrope" android:text="@string/draft_pdf_document_metadata" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="@dimen/dp_1" android:layout_marginTop="@dimen/dp_16" android:background="@color/legal_lens_input_stroke" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:fontFamily="@font/manrope" android:text="@string/draft_pdf_selected_version_note" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_13" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_chatbot_draft_warning" android:drawableStart="@drawable/ic_chatbot_error" android:drawablePadding="@dimen/dp_8" android:fontFamily="@font/manrope" android:gravity="center_vertical" android:padding="@dimen/dp_12" android:text="@string/draft_pdf_warning" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
        <LinearLayout android:id="@+id/pdfOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:orientation="vertical">
            <TextView android:id="@+id/pdfCreate" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:background="@drawable/bg_chatbot_primary_action" android:clickable="true" android:focusable="true" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_pdf_create" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/pdfShare" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_pdf_create_share" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/pdfCancelOption" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_pdf_cancel" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pdfLoading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:gravity="center" android:orientation="vertical" android:padding="@dimen/dp_20" android:visibility="gone">
            <ProgressBar android:layout_width="@dimen/dp_40" android:layout_height="@dimen/dp_40" android:indeterminateTint="@color/legal_lens_auth_accent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_pdf_loading_title" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_16" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_pdf_loading_body" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_13" />
            <TextView android:id="@+id/pdfLoadingSaveFile" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_chatbot_primary_action" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_save_file" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/pdfLoadingShareFile" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_share_file" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/pdfLoadingCancel" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_cancel" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pdfError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope" android:text="@string/draft_pdf_error_title" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_16" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:fontFamily="@font/manrope" android:text="@string/draft_pdf_error_body" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_13" />
            <TextView android:id="@+id/pdfRetry" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_chatbot_primary_action" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_retry" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/pdfSaveFileError" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_save_file" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/pdfShareFileError" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_share_file" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/pdfCancelError" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_cancel" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pdfReady" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_pdf_ready_title" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_16" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_pdf_ready_body" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_13" />
            <TextView android:id="@+id/pdfOpenPreview" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_chatbot_primary_action" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_open_preview" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/pdfSaveFileReady" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_chatbot_primary_action" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_save_file" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/pdfShareFileReady" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_share_file" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
            <TextView android:id="@+id/pdfClose" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/draft_pdf_close" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
