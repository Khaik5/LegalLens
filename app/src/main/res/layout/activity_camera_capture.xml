<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_capture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_camera_capture_backdrop">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_capture_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/camera_capture_preview_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/camera_preview_overlay"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/camera_capture_close"
        android:layout_width="@dimen/camera_capture_icon_size"
        android:layout_height="@dimen/camera_capture_icon_size"
        android:layout_marginStart="@dimen/camera_capture_side_padding"
        android:layout_marginTop="@dimen/camera_capture_top_padding"
        android:background="@drawable/bg_camera_capture_control"
        android:contentDescription="@string/camera_capture_close_description"
        android:padding="@dimen/upload_back_icon_inset"
        android:src="@drawable/ic_camera_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/camera_capture_settings"
        android:layout_width="@dimen/camera_capture_icon_size"
        android:layout_height="@dimen/camera_capture_icon_size"
        android:layout_marginTop="@dimen/camera_capture_top_padding"
        android:layout_marginEnd="@dimen/camera_capture_side_padding"
        android:background="@drawable/bg_camera_capture_control"
        android:contentDescription="@string/camera_capture_settings_description"
        android:padding="@dimen/upload_back_icon_inset"
        android:src="@drawable/ic_camera_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/camera_capture_flash"
        android:layout_width="@dimen/camera_capture_icon_size"
        android:layout_height="@dimen/camera_capture_icon_size"
        android:layout_marginTop="@dimen/camera_capture_top_padding"
        android:layout_marginEnd="@dimen/camera_permission_button_bottom_margin"
        android:background="@drawable/bg_camera_capture_control"
        android:contentDescription="@string/camera_capture_flash_description"
        android:padding="@dimen/upload_back_icon_inset"
        android:src="@drawable/ic_camera_flash"
        app:layout_constraintEnd_toStartOf="@id/camera_capture_settings"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/camera_capture_chip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/camera_capture_chip_height"
        android:layout_marginTop="@dimen/camera_capture_chip_top_margin"
        android:background="@drawable/bg_camera_capture_chip"
        android:gravity="center"
        android:paddingStart="@dimen/camera_capture_chip_horizontal_padding"
        android:paddingEnd="@dimen/camera_capture_chip_horizontal_padding"
        android:text="@string/camera_capture_auto_align"
        android:textColor="@color/white"
        android:textSize="@dimen/camera_capture_chip_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camera_capture_close" />

    <View
        android:id="@+id/camera_capture_scan_frame"
        android:layout_width="0dp"
        android:layout_height="@dimen/camera_capture_frame_height"
        android:layout_marginStart="@dimen/camera_capture_frame_side_margin"
        android:layout_marginTop="@dimen/camera_capture_frame_top_margin"
        android:layout_marginEnd="@dimen/camera_capture_frame_side_margin"
        android:background="@drawable/bg_camera_scan_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/camera_capture_instruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/camera_capture_side_padding"
        android:layout_marginEnd="@dimen/camera_capture_side_padding"
        android:gravity="center"
        android:text="@string/camera_capture_instruction"
        android:textColor="@color/white"
        android:textSize="@dimen/camera_capture_instruction_text_size"
        app:layout_constraintBottom_toTopOf="@id/camera_capture_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/camera_capture_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/camera_capture_side_padding"
        android:layout_marginEnd="@dimen/camera_capture_side_padding"
        android:layout_marginBottom="@dimen/camera_capture_controls_bottom_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/camera_capture_library"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/camera_capture_library_icon_size"
                android:layout_height="@dimen/camera_capture_library_icon_size"
                android:src="@drawable/ic_camera_gallery" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_capture_library"
                android:textColor="@color/white"
                android:textSize="@dimen/camera_capture_control_text_size" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/camera_capture_shutter"
            android:layout_width="@dimen/camera_capture_shutter_outer_size"
            android:layout_height="@dimen/camera_capture_shutter_outer_size"
            android:background="@drawable/bg_camera_capture_shutter"
            android:contentDescription="@string/camera_permission_allow" />

        <LinearLayout
            android:id="@+id/camera_capture_continue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/camera_capture_count"
                android:layout_width="@dimen/camera_capture_count_size"
                android:layout_height="@dimen/camera_capture_count_size"
                android:background="@drawable/bg_camera_capture_count"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/camera_capture_control_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/camera_capture_continue"
                android:textColor="@color/white"
                android:textSize="@dimen/camera_capture_control_text_size" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
