<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_8"
    android:background="@drawable/bg_analysis_risk_detail_legal_reference"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/dp_14">

    <FrameLayout
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:background="@drawable/bg_analysis_key_facts_reference">

        <ImageView
            android:layout_width="@dimen/analysis_result_item_icon_size"
            android:layout_height="@dimen/analysis_result_item_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_book"
            app:tint="@color/ocr_saved_teal" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/analysisRiskLegalBasisTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_13"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/analysisRiskLegalBasisExcerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_11" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/legal_lens_auth_accent" />
</LinearLayout>
