<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/compareSelectRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/legal_lens_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/dp_56" android:gravity="center_vertical" android:paddingStart="@dimen/dp_16" android:paddingEnd="@dimen/dp_16">
        <ImageButton android:id="@+id/compareSelectBack" android:layout_width="@dimen/dp_40" android:layout_height="@dimen/dp_40" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/analysis_risk_findings_back_content_description" android:padding="@dimen/dp_10" android:src="@drawable/ic_contract_search_back" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dp_12" android:text="@string/compare_title" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_18" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingStart="@dimen/dp_20" android:paddingEnd="@dimen/dp_20">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_20" android:text="@string/compare_instruction" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_14" />
        <EditText android:id="@+id/compareSelectSearch" android:layout_width="match_parent" android:layout_height="@dimen/dp_48" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_contract_search" android:drawableStart="@drawable/ic_contract_search" android:drawablePadding="@dimen/dp_10" android:hint="@string/compare_search" android:inputType="text" android:singleLine="true" android:paddingStart="@dimen/dp_12" android:paddingEnd="@dimen/dp_12" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_14" />
        <TextView android:id="@+id/compareSelectNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_compare_notice" android:padding="@dimen/dp_12" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/compareSelectList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="@dimen/dp_16" android:layout_weight="1" android:clipToPadding="false" />
        <TextView android:id="@+id/compareSelectEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/dp_16" android:text="@string/compare_no_matches" android:textColor="@color/legal_lens_secondary_text" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" android:orientation="vertical" android:padding="@dimen/dp_20">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/compare_selected_label" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_14" />
            <TextView android:id="@+id/compareSelectCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/legal_lens_auth_accent" android:textStyle="bold" android:textSize="@dimen/sp_14" />
        </LinearLayout>
        <TextView android:id="@+id/compareSelectSubmit" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_compare_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/compare_action" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
        <TextView android:id="@+id/compareSelectHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_12" android:gravity="center" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
    </LinearLayout>
</LinearLayout>
