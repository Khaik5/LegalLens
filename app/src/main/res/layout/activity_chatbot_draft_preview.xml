<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/draftPreviewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12">

        <ImageButton
            android:id="@+id/draftBack"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_draft_back"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_contract_search_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_weight="1"
            android:fontFamily="@font/manrope"
            android:text="@string/chatbot_draft_preview_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/draftMore"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_draft_more"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_analysis_risk_overview_more" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/notification_system_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_8">

        <TextView
            android:id="@+id/draftContractName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/draftVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:fontFamily="@font/manrope"
            android:text="@string/chatbot_draft_version_metadata"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/bg_chatbot_draft_warning"
            android:drawableStart="@drawable/ic_alert_triangle"
            android:drawablePadding="@dimen/dp_8"
            android:drawableTint="@color/chatbot_draft_notice_icon"
            android:fontFamily="@font/manrope"
            android:gravity="center_vertical"
            android:lineSpacingExtra="@dimen/dp_2"
            android:padding="@dimen/dp_12"
            android:text="@string/chatbot_draft_missing_warning"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/draftPageCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:textColor="@color/legal_lens_status_text"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/draftPrevious"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_36"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/viewer_previous_page"
                android:padding="@dimen/dp_8"
                android:src="@drawable/ic_chevron_left" />

            <ImageButton
                android:id="@+id/draftNext"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_36"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/viewer_next_page"
                android:padding="@dimen/dp_8"
                android:src="@drawable/ic_contract_search_chevron_right" />

            <ImageButton
                android:id="@+id/draftZoomOut"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chatbot_draft_zoom_out"
                android:padding="@dimen/dp_8"
                android:src="@drawable/ic_viewer_zoom_out" />

            <TextView
                android:id="@+id/draftZoomLevel"
                android:layout_width="@dimen/dp_52"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_12" />

            <ImageButton
                android:id="@+id/draftZoomIn"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chatbot_draft_zoom_in"
                android:padding="@dimen/dp_8"
                android:src="@drawable/ic_viewer_zoom_in" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/draftPagePager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/legal_lens_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/draftEdit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/chatbot_draft_edit_action_short"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/draftRegenerate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/chatbot_draft_regenerate_action"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/draftExport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/chatbot_draft_export_action"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/draftAskAi"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_chatbot_new_state_suggestion"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_ask_ai_action"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/draftSave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_chatbot_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_save_action"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
