<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/helpFaqRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="@dimen/dp_16">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/helpFaqQuestion" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_14" android:textStyle="bold" />
        <ImageView android:id="@+id/helpFaqChevron" android:layout_width="@dimen/dp_18" android:layout_height="@dimen/dp_18" android:layout_marginStart="@dimen/dp_8" android:contentDescription="@null" android:src="@drawable/ic_chatbot_chevron_down" />
    </LinearLayout>
    <TextView android:id="@+id/helpFaqAnswer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_12" android:lineSpacingExtra="@dimen/dp_2" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_13" android:visibility="gone" />
</LinearLayout>
