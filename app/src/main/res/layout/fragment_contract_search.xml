<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background">

    <LinearLayout
        android:id="@+id/searchAppBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_68"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/contract_search_back_description"
            android:padding="@dimen/dp_10"
            android:src="@drawable/ic_contract_search_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_44"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_weight="1"
            android:background="@drawable/bg_contract_search_active"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12">

            <ImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:contentDescription="@null"
                android:src="@drawable/ic_contract_search"
                android:tint="@color/legal_lens_auth_accent" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/contract_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="@dimen/dp_0"
                android:singleLine="true"
                android:textColor="@color/legal_lens_status_text"
                android:textColorHint="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_14" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:background="@drawable/bg_contract_search_clear"
                android:contentDescription="@string/contract_search_clear_description"
                android:padding="@dimen/dp_4"
                android:src="@drawable/ic_contract_search_clear" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_24"
            android:paddingTop="@dimen/dp_24"
            android:paddingEnd="@dimen/dp_24"
            android:paddingBottom="@dimen/dp_24">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_18"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/contract_search_recent_title"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_12"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRecentBitexco"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_contract_filter_inactive"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_contract_search_history"
                    android:drawablePadding="@dimen/dp_6"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/dp_12"
                    android:paddingEnd="@dimen/dp_12"
                    android:text="@string/contract_search_recent_bitexco"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_13" />

                <TextView
                    android:id="@+id/tvRecentNda"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dp_8"
                    android:background="@drawable/bg_contract_filter_inactive"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_contract_search_history"
                    android:drawablePadding="@dimen/dp_6"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/dp_12"
                    android:paddingEnd="@dimen/dp_12"
                    android:text="@string/contract_search_recent_nda"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_8"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRecentLabor"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_contract_filter_inactive"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_contract_search_history"
                    android:drawablePadding="@dimen/dp_6"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/dp_12"
                    android:paddingEnd="@dimen/dp_12"
                    android:text="@string/contract_search_recent_labor"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_13" />

                <TextView
                    android:id="@+id/tvRecentEquipment"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dp_8"
                    android:background="@drawable/bg_contract_filter_inactive"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_contract_search_history"
                    android:drawablePadding="@dimen/dp_6"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/dp_12"
                    android:paddingEnd="@dimen/dp_12"
                    android:text="@string/contract_search_recent_equipment"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResultsTitle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_18"
                android:layout_marginTop="@dimen/dp_24"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
