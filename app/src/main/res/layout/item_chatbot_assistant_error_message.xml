<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/chatbot_error_card_height"
    android:layout_marginBottom="@dimen/chatbot_message_row_spacing"
    android:background="@drawable/bg_chatbot_error_message"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/chatbot_error_card_padding">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/chatbot_error_icon_size"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/chatbot_error_icon_size"
            android:layout_height="@dimen/chatbot_error_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_chatbot_error" />

        <TextView
            android:id="@+id/chatbotErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chatbot_error_title_margin_start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/analysis_result_risk"
            android:textSize="@dimen/chatbot_error_title_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chatbotErrorRetry"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/chatbot_error_retry_height"
        android:layout_marginTop="@dimen/chatbot_error_retry_margin_top"
        android:background="@drawable/bg_chatbot_error_retry"
        android:clickable="true"
        android:contentDescription="@string/chatbot_error_retry_content_description"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/chatbot_error_retry_padding_horizontal"
        android:paddingEnd="@dimen/chatbot_error_retry_padding_horizontal">

        <ImageView
            android:layout_width="@dimen/chatbot_error_retry_icon_size"
            android:layout_height="@dimen/chatbot_error_retry_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_chatbot_retry" />

        <TextView
            android:id="@+id/chatbotErrorRetryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chatbot_error_retry_icon_margin_end"
            android:includeFontPadding="false"
            android:textColor="@color/analysis_result_risk"
            android:textSize="@dimen/chatbot_error_retry_text_size"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
