<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    android:background="@drawable/bg_analysis_legal_reference_card"
    android:orientation="vertical"
    android:padding="@dimen/dp_16">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        android:text="••••••••••••••••••••••••••••••••••••"
        android:textColor="@color/legal_lens_secondary_text" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.20"
        android:importantForAccessibility="no"
        android:text="••••••••••••••••••••••••••••••••••••"
        android:textColor="@color/legal_lens_secondary_text" />
    <TextView
        android:id="@+id/analysisLockedCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/legal_lens_secondary_text" />
    <TextView
        android:id="@+id/analysisLockedUnlock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/bg_chatbot_primary_action"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold" />
</LinearLayout>
