<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background">

    <LinearLayout
        android:id="@+id/layoutPasswordToolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/legal_lens_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_password_back_description"
            android:padding="8dp"
            android:src="@drawable/ic_contract_search_back"
            android:tint="@color/legal_lens_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans"
            android:text="@string/profile_password_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPasswordContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnUpdatePassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutPasswordToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_password_current_label"
                android:textColor="@color/legal_lens_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_profile_edit_input"
                android:gravity="center_vertical"
                android:hint="@string/profile_password_hint_masked"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="@color/legal_lens_primary"
                android:textColorHint="@color/legal_lens_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvCurrentPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/legal_lens_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/profile_password_new_label"
                android:textColor="@color/legal_lens_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_profile_edit_input"
                android:gravity="center_vertical"
                android:hint="@string/profile_password_hint_masked"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="@color/legal_lens_primary"
                android:textColorHint="@color/legal_lens_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvNewPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/legal_lens_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/profile_password_confirm_label"
                android:textColor="@color/legal_lens_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etConfirmationPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_profile_edit_input"
                android:gravity="center_vertical"
                android:hint="@string/profile_password_confirm_hint"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="@color/legal_lens_primary"
                android:textColorHint="@color/legal_lens_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvConfirmationPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/legal_lens_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/profile_password_requirements"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/requirementMinimumLength"
                layout="@layout/item_profile_password_requirement"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="10dp" />

            <include
                android:id="@+id/requirementMixedCase"
                layout="@layout/item_profile_password_requirement"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="8dp" />

            <include
                android:id="@+id/requirementNumberOrSpecial"
                layout="@layout/item_profile_password_requirement"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/btnUpdatePassword"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_profile_edit_save"
        android:gravity="center"
        android:text="@string/profile_password_submit"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
