<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_page_manager_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/upload_background">

    <LinearLayout
        android:id="@+id/camera_page_app_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/camera_permission_app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/camera_permission_side_padding"
        android:paddingEnd="@dimen/camera_permission_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/camera_page_back"
            android:layout_width="@dimen/upload_back_button_size"
            android:layout_height="@dimen/upload_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/camera_permission_back_description"
            android:padding="@dimen/upload_back_icon_inset"
            android:src="@drawable/ic_upload_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/upload_title_margin_start"
            android:layout_weight="1"
            android:text="@string/camera_page_manager_title"
            android:textColor="@color/upload_navy"
            android:textSize="@dimen/upload_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/camera_page_count"
            android:layout_width="@dimen/camera_capture_count_size"
            android:layout_height="@dimen/camera_capture_count_size"
            android:background="@drawable/bg_camera_capture_count"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/camera_capture_control_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/camera_page_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/camera_permission_side_padding"
        android:layout_marginTop="@dimen/upload_content_top_padding"
        android:text="@string/camera_page_manager_header"
        android:textColor="@color/upload_body"
        android:textSize="@dimen/camera_page_header_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camera_page_app_bar" />

    <TextView
        android:id="@+id/camera_page_clear_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/camera_permission_side_padding"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:text="@string/camera_page_manager_clear_all"
        android:textColor="@color/upload_teal"
        android:textSize="@dimen/camera_page_clear_text_size"
        app:layout_constraintBaseline_toBaselineOf="@id/camera_page_header"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/camera_page_list"
        android:layout_width="0dp"
        android:layout_height="@dimen/camera_page_list_height"
        android:layout_marginStart="@dimen/camera_permission_side_padding"
        android:layout_marginTop="@dimen/upload_card_top_margin"
        android:layout_marginEnd="@dimen/camera_permission_side_padding"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camera_page_header" />

    <TextView
        android:id="@+id/camera_page_add"
        android:layout_width="@dimen/camera_page_thumbnail_width"
        android:layout_height="@dimen/camera_page_add_height"
        android:layout_marginStart="@dimen/camera_permission_side_padding"
        android:background="@drawable/bg_camera_page_add"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/camera_page_manager_add"
        android:textAlignment="center"
        android:textColor="@color/upload_teal"
        android:textSize="@dimen/camera_page_add_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camera_page_list" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/camera_permission_side_padding"
        android:layout_marginEnd="@dimen/camera_permission_side_padding"
        android:paddingBottom="@dimen/camera_permission_buttons_bottom_padding"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/camera_page_complete"
            android:layout_width="match_parent"
            android:layout_height="@dimen/camera_permission_button_height"
            android:background="@drawable/bg_camera_permission_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/camera_page_manager_complete"
            android:textColor="@color/white"
            android:textSize="@dimen/upload_card_description_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/camera_page_retake_last"
            android:layout_width="match_parent"
            android:layout_height="@dimen/camera_permission_button_height"
            android:layout_marginTop="@dimen/camera_permission_button_bottom_margin"
            android:background="@drawable/bg_camera_permission_secondary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/camera_page_manager_retake_last"
            android:textColor="@color/upload_navy"
            android:textSize="@dimen/upload_card_description_text_size"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
