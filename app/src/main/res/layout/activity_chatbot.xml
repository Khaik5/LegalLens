<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatbotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatbotHeader"
        android:layout_width="0dp"
        android:layout_height="@dimen/chatbot_header_height"
        android:paddingStart="@dimen/chatbot_side_padding"
        android:paddingEnd="@dimen/chatbot_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/chatbotBack"
            android:layout_width="@dimen/chatbot_header_action_size"
            android:layout_height="@dimen/chatbot_header_action_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_back_content_description"
            android:padding="@dimen/chatbot_header_action_padding"
            android:src="@drawable/ic_chatbot_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/chatbotHeaderLabels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/chatbotContractName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/chatbot_header_title_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chatbotContractType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chatbot_header_subtitle_margin_top"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/chatbot_header_subtitle_text_size" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/chatbotMore"
            android:layout_width="@dimen/chatbot_header_action_size"
            android:layout_height="@dimen/chatbot_header_action_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_more_content_description"
            android:padding="@dimen/chatbot_header_action_padding"
            android:src="@drawable/ic_analysis_risk_overview_more"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatbotMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/chatbot_side_padding"
        android:paddingTop="@dimen/chatbot_messages_padding_vertical"
        android:paddingEnd="@dimen/chatbot_side_padding"
        android:paddingBottom="@dimen/chatbot_messages_padding_vertical"
        app:layout_constraintBottom_toTopOf="@id/chatbotSuggestions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatbotHeader" />

    <LinearLayout
        android:id="@+id/chatbotSuggestions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/legal_lens_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/chatbot_side_padding"
        android:paddingTop="@dimen/chatbot_suggestions_vertical_padding"
        android:paddingEnd="@dimen/chatbot_side_padding"
        android:paddingBottom="@dimen/chatbot_suggestions_vertical_padding"
        app:layout_constraintBottom_toTopOf="@id/chatbotComposer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/chatbotSuggestionContractTerm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/chatbot_suggestion_height"
            android:background="@drawable/bg_chatbot_suggestion"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/chatbot_suggestion_padding_horizontal"
            android:paddingEnd="@dimen/chatbot_suggestion_padding_horizontal"
            android:textColor="@color/legal_lens_auth_accent"
            android:textSize="@dimen/chatbot_suggestion_text_size" />

        <TextView
            android:id="@+id/chatbotSuggestionSalary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/chatbot_suggestion_height"
            android:layout_marginTop="@dimen/chatbot_suggestion_gap"
            android:background="@drawable/bg_chatbot_suggestion"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/chatbot_suggestion_padding_horizontal"
            android:paddingEnd="@dimen/chatbot_suggestion_padding_horizontal"
            android:textColor="@color/legal_lens_auth_accent"
            android:textSize="@dimen/chatbot_suggestion_text_size" />

        <TextView
            android:id="@+id/chatbotSuggestionNotableTerms"
            android:layout_width="match_parent"
            android:layout_height="@dimen/chatbot_suggestion_height"
            android:layout_marginTop="@dimen/chatbot_suggestion_gap"
            android:background="@drawable/bg_chatbot_suggestion"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/chatbot_suggestion_padding_horizontal"
            android:paddingEnd="@dimen/chatbot_suggestion_padding_horizontal"
            android:textColor="@color/legal_lens_auth_accent"
            android:textSize="@dimen/chatbot_suggestion_text_size" />

        <TextView
            android:id="@+id/chatbotSuggestionRightsAndObligations"
            android:layout_width="match_parent"
            android:layout_height="@dimen/chatbot_suggestion_height"
            android:layout_marginTop="@dimen/chatbot_suggestion_gap"
            android:background="@drawable/bg_chatbot_suggestion"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/chatbot_suggestion_padding_horizontal"
            android:paddingEnd="@dimen/chatbot_suggestion_padding_horizontal"
            android:textColor="@color/legal_lens_auth_accent"
            android:textSize="@dimen/chatbot_suggestion_text_size" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatbotEmptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/chatbotComposer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatbotHeader">

        <ImageView
            android:id="@+id/chatbotNewStateMascot"
            android:layout_width="@dimen/chatbot_new_state_mascot_size"
            android:layout_height="@dimen/chatbot_new_state_mascot_size"
            android:layout_marginTop="@dimen/chatbot_new_state_mascot_top_margin"
            android:background="@drawable/bg_chatbot_new_state_mascot"
            android:contentDescription="@null"
            android:padding="@dimen/dp_20"
            android:src="@drawable/ic_chatbot_new_state_message"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/chatbotNewStateTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chatbot_new_state_side_padding"
            android:layout_marginTop="@dimen/chatbot_new_state_title_margin_top"
            android:layout_marginEnd="@dimen/chatbot_new_state_side_padding"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/chatbot_new_state_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/chatbot_new_state_title_text_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chatbotNewStateMascot" />

        <TextView
            android:id="@+id/chatbotNewStateDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chatbot_new_state_side_padding"
            android:layout_marginTop="@dimen/chatbot_new_state_description_margin_top"
            android:layout_marginEnd="@dimen/chatbot_new_state_side_padding"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/chatbot_new_state_description_line_spacing"
            android:text="@string/chatbot_new_state_description"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/chatbot_new_state_description_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chatbotNewStateTitle" />

        <LinearLayout
            android:id="@+id/chatbotNewSuggestions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chatbot_new_state_side_padding"
            android:layout_marginTop="@dimen/chatbot_new_state_suggestions_margin_top"
            android:layout_marginEnd="@dimen/chatbot_new_state_side_padding"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chatbotNewStateDescription">

            <TextView
                android:id="@+id/chatbotNewSuggestionRisk"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chatbot_new_state_suggestion_height"
                android:background="@drawable/bg_chatbot_new_state_suggestion"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/chatbot_new_state_suggestion_padding"
                android:paddingEnd="@dimen/chatbot_new_state_suggestion_padding"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/chatbot_suggestion_text_size" />

            <TextView
                android:id="@+id/chatbotNewSuggestionPayment"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chatbot_new_state_suggestion_height"
                android:layout_marginTop="@dimen/chatbot_new_state_suggestion_gap"
                android:background="@drawable/bg_chatbot_new_state_suggestion"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/chatbot_new_state_suggestion_padding"
                android:paddingEnd="@dimen/chatbot_new_state_suggestion_padding"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/chatbot_suggestion_text_size" />

            <TextView
                android:id="@+id/chatbotNewSuggestionPenalty"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chatbot_new_state_suggestion_height"
                android:layout_marginTop="@dimen/chatbot_new_state_suggestion_gap"
                android:background="@drawable/bg_chatbot_new_state_suggestion"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/chatbot_new_state_suggestion_padding"
                android:paddingEnd="@dimen/chatbot_new_state_suggestion_padding"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/chatbot_suggestion_text_size" />
        </LinearLayout>

        <TextView
            android:id="@+id/chatbotNewStateDisclaimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chatbot_new_state_side_padding"
            android:layout_marginTop="@dimen/chatbot_new_state_disclaimer_margin_top"
            android:layout_marginEnd="@dimen/chatbot_new_state_side_padding"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/chatbot_new_state_disclaimer_line_spacing"
            android:text="@string/chatbot_new_state_disclaimer"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/chatbot_new_state_disclaimer_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chatbotNewSuggestions" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatbotComposer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/legal_lens_background"
        android:paddingStart="@dimen/chatbot_side_padding"
        android:paddingTop="@dimen/chatbot_composer_vertical_padding"
        android:paddingEnd="@dimen/chatbot_side_padding"
        android:paddingBottom="@dimen/chatbot_composer_vertical_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/chatbotAttach"
            android:layout_width="@dimen/chatbot_attach_size"
            android:layout_height="@dimen/chatbot_attach_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_attach_content_description"
            android:padding="@dimen/dp_2"
            android:src="@drawable/ic_chatbot_attach"
            app:layout_constraintBottom_toBottomOf="@id/chatbotInput"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/chatbotInput" />

        <EditText
            android:id="@+id/chatbotInput"
            android:layout_width="0dp"
            android:layout_height="@dimen/chatbot_input_height"
            android:layout_marginStart="@dimen/chatbot_composer_gap"
            android:layout_marginEnd="@dimen/chatbot_composer_gap"
            android:background="@drawable/bg_chatbot_input"
            android:fontFamily="sans-serif"
            android:hint="@string/chatbot_input_hint"
            android:imeOptions="actionSend"
            android:includeFontPadding="false"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:paddingStart="@dimen/chatbot_input_padding_horizontal"
            android:paddingEnd="@dimen/chatbot_input_padding_horizontal"
            android:textColor="@color/legal_lens_status_text"
            android:textColorHint="@color/legal_lens_secondary_text"
            android:textSize="@dimen/chatbot_message_text_size"
            app:layout_constraintEnd_toStartOf="@id/chatbotSend"
            app:layout_constraintStart_toEndOf="@id/chatbotAttach"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/chatbotSend"
            android:layout_width="@dimen/chatbot_send_size"
            android:layout_height="@dimen/chatbot_send_size"
            android:background="@drawable/bg_chatbot_send"
            android:contentDescription="@string/chatbot_send_content_description"
            android:padding="@dimen/chatbot_send_icon_padding"
            android:src="@drawable/ic_chatbot_send"
            app:layout_constraintBottom_toBottomOf="@id/chatbotInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/chatbotInput" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/chatbotDrawerOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="@dimen/chatbot_drawer_elevation"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/chatbotDrawerScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/chatbot_drawer_scrim"
            android:clickable="true"
            android:focusable="true" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chatbotDrawerPanel"
            android:layout_width="@dimen/chatbot_drawer_width"
            android:layout_height="match_parent"
            android:background="@color/chatbot_drawer_surface"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/chatbotDrawerBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chatbot_drawer_brand_margin_start"
                android:layout_marginTop="@dimen/chatbot_drawer_brand_margin_top"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/chatbot_drawer_brand"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/chatbot_drawer_brand_text_size"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chatbotDrawerWorkspace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chatbot_drawer_brand_margin_start"
                android:layout_marginTop="@dimen/chatbot_drawer_section_margin_top"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/chatbot_drawer_workspace"
                android:textColor="@color/chatbot_drawer_section_text"
                android:textSize="@dimen/chatbot_drawer_section_text_size"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chatbotDrawerActiveChat"
                android:layout_width="0dp"
                android:layout_height="@dimen/chatbot_drawer_active_height"
                android:layout_marginStart="@dimen/chatbot_drawer_active_margin_horizontal"
                android:layout_marginTop="@dimen/chatbot_drawer_active_margin_top"
                android:layout_marginEnd="@dimen/chatbot_drawer_active_margin_horizontal"
                android:background="@drawable/bg_chatbot_drawer_active"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="@dimen/chatbot_drawer_active_padding_horizontal"
                android:paddingEnd="@dimen/chatbot_drawer_active_padding_horizontal"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/chatbot_drawer_item_text_size"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chatbotDrawerNewChat"
                android:layout_width="0dp"
                android:layout_height="@dimen/chatbot_drawer_item_height"
                android:layout_marginStart="@dimen/chatbot_drawer_item_margin_start"
                android:layout_marginTop="@dimen/chatbot_drawer_item_first_margin_top"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="@dimen/chatbot_drawer_item_icon_gap"
                android:drawableStart="@drawable/ic_chatbot_drawer_new"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/chatbot_drawer_new_chat"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/chatbot_drawer_item_text_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chatbotDrawerHistory"
                android:layout_width="0dp"
                android:layout_height="@dimen/chatbot_drawer_item_height"
                android:layout_marginStart="@dimen/chatbot_drawer_item_margin_start"
                android:layout_marginTop="@dimen/chatbot_drawer_item_spacing"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="@dimen/chatbot_drawer_item_icon_gap"
                android:drawableStart="@drawable/ic_chatbot_drawer_history"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/chatbot_drawer_history"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/chatbot_drawer_item_text_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chatbotDrawerNewChat" />

            <TextView
                android:id="@+id/chatbotDrawerHelp"
                android:layout_width="0dp"
                android:layout_height="@dimen/chatbot_drawer_item_height"
                android:layout_marginStart="@dimen/chatbot_drawer_item_margin_start"
                android:layout_marginTop="@dimen/chatbot_drawer_item_spacing"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="@dimen/chatbot_drawer_item_icon_gap"
                android:drawableStart="@drawable/ic_chatbot_drawer_help"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/chatbot_drawer_help"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/chatbot_drawer_item_text_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/chatbotDrawerHistory" />

            <TextView
                android:id="@+id/chatbotDrawerProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chatbot_drawer_brand_margin_start"
                android:layout_marginBottom="@dimen/chatbot_drawer_profile_margin_bottom"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/chatbot_drawer_profile"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/chatbot_drawer_profile_text_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
