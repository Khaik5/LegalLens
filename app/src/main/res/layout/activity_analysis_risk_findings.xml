<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/analysisRiskFindingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/analysisRiskFindingsHeader"
        android:layout_width="0dp"
        android:layout_height="@dimen/analysis_header_height"
        android:paddingStart="@dimen/analysis_header_side_padding"
        android:paddingEnd="@dimen/analysis_header_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/analysisRiskFindingsBack"
            android:layout_width="@dimen/analysis_back_button_size"
            android:layout_height="@dimen/analysis_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/analysis_risk_findings_back_content_description"
            android:padding="@dimen/analysis_back_icon_padding"
            android:src="@drawable/ic_upload_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/analysis_risk_findings_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/analysis_header_title_text_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="@dimen/analysis_back_button_size"
            android:layout_height="@dimen/analysis_back_button_size"
            android:contentDescription="@string/analysis_risk_findings_more_content_description"
            android:padding="@dimen/analysis_back_icon_padding"
            android:src="@drawable/ic_analysis_risk_overview_more"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <HorizontalScrollView
        android:id="@+id/analysisRiskFindingsFilters"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_54"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/analysisRiskFindingsHeader">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16">

            <TextView
                android:id="@+id/analysisRiskFindingsFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_34"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/dp_14"
                android:paddingEnd="@dimen/dp_14"
                android:text="@string/analysis_risk_findings_filter_all"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analysisRiskFindingsFilterHigh"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_34"
                android:layout_marginStart="@dimen/dp_8"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/dp_14"
                android:paddingEnd="@dimen/dp_14"
                android:text="@string/analysis_risk_findings_filter_high"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analysisRiskFindingsFilterMedium"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_34"
                android:layout_marginStart="@dimen/dp_8"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/dp_14"
                android:paddingEnd="@dimen/dp_14"
                android:text="@string/analysis_risk_findings_filter_medium"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analysisRiskFindingsFilterLow"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_34"
                android:layout_marginStart="@dimen/dp_8"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/dp_14"
                android:paddingEnd="@dimen/dp_14"
                android:text="@string/analysis_risk_findings_filter_low"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/analysisRiskFindingsItems"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_2"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/analysisRiskFindingsFilters" />
</androidx.constraintlayout.widget.ConstraintLayout>
