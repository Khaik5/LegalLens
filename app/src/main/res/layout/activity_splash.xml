<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    tools:context=".SplashActivity">

    <View
        android:layout_width="@dimen/splash_motif_size"
        android:layout_height="@dimen/splash_motif_size"
        android:background="@drawable/splash_teal_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        android:translationY="@dimen/splash_motif_top" />

    <View
        android:layout_width="@dimen/splash_surface_size"
        android:layout_height="@dimen/splash_surface_size"
        android:background="@drawable/splash_surface_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationY="@dimen/splash_motif_top" />

    <ImageView
        android:id="@+id/splash_logo"
        android:layout_width="@dimen/splash_logo_width"
        android:layout_height="@dimen/splash_logo_height"
        android:contentDescription="@string/app_name"
        android:src="@drawable/legallens_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationY="@dimen/splash_logo_top" />

    <ProgressBar
        android:id="@+id/splash_progress"
        android:layout_width="@dimen/splash_progress_width"
        android:layout_height="@dimen/splash_progress_height"
        android:indeterminate="false"
        android:max="100"
        android:progress="60"
        android:progressDrawable="@drawable/splash_progress_track"
        android:background="@drawable/splash_progress_track"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationY="@dimen/splash_progress_top" />

    <TextView
        android:id="@+id/splash_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:letterSpacing="@dimen/splash_label_letter_spacing"
        android:text="@string/splash_initializing_security"
        android:textColor="@color/splash_text"
        android:textSize="@dimen/splash_label_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationY="@dimen/splash_label_top" />



</androidx.constraintlayout.widget.ConstraintLayout>
