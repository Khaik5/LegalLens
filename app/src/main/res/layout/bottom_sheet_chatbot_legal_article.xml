<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chatbot_attachment_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/chatbot_attachment_sheet_horizontal_padding"
    android:paddingTop="@dimen/chatbot_attachment_sheet_top_padding"
    android:paddingEnd="@dimen/chatbot_attachment_sheet_horizontal_padding"
    android:paddingBottom="@dimen/dp_24">

    <View
        android:layout_width="@dimen/chatbot_attachment_sheet_handle_width"
        android:layout_height="@dimen/chatbot_attachment_sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_contract_filter_handle" />

    <TextView
        android:id="@+id/chatbotArticleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/chatbot_attachment_sheet_title_margin_top"
        android:fontFamily="@font/manrope"
        android:includeFontPadding="false"
        android:textColor="@color/legal_lens_primary"
        android:textSize="@dimen/sp_18"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/chatbotArticleLoading"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginBottom="@dimen/dp_24"
        android:indeterminate="true" />

    <ScrollView
        android:id="@+id/chatbotArticleScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:visibility="gone">

        <TextView
            android:id="@+id/chatbotArticleContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:lineSpacingExtra="@dimen/dp_4"
            android:textColor="@color/legal_lens_status_text"
            android:textIsSelectable="true"
            android:textSize="@dimen/sp_14" />
    </ScrollView>

    <TextView
        android:id="@+id/chatbotArticleMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:fontFamily="@font/manrope"
        android:textColor="@color/legal_lens_secondary_text"
        android:textSize="@dimen/sp_14"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chatbotArticleClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8"
        android:text="@string/chatbot_article_close"
        android:textColor="@color/legal_lens_auth_accent"
        android:textSize="@dimen/sp_14"
        android:textStyle="bold" />
</LinearLayout>
