<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/helpRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/legal_lens_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/dp_56" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="center_vertical" android:paddingStart="@dimen/dp_16" android:paddingEnd="@dimen/dp_16">
        <ImageButton android:id="@+id/helpBack" android:layout_width="@dimen/dp_40" android:layout_height="@dimen/dp_40" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/chatbot_history_back_content_description" android:padding="@dimen/dp_10" android:src="@drawable/ic_contract_search_back" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dp_12" android:text="@string/chatbot_help_title" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_18" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingStart="@dimen/dp_20" android:paddingEnd="@dimen/dp_20">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="@dimen/dp_20" android:paddingBottom="@dimen/dp_24">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chatbot_help_heading" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_20" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:lineSpacingExtra="@dimen/dp_2" android:text="@string/chatbot_help_intro" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_14" />
            <include android:id="@+id/helpAttachment" layout="@layout/item_information_card" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_24" android:text="@string/chatbot_help_questions" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_16" android:textStyle="bold" />
            <TextView android:id="@+id/helpQuestionTerm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:padding="@dimen/dp_14" android:text="@string/chatbot_help_question_term" android:textColor="@color/legal_lens_auth_accent" android:textSize="@dimen/sp_13" />
            <TextView android:id="@+id/helpQuestionPayment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:padding="@dimen/dp_14" android:text="@string/chatbot_help_question_payment" android:textColor="@color/legal_lens_auth_accent" android:textSize="@dimen/sp_13" />
            <TextView android:id="@+id/helpQuestionObligations" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:padding="@dimen/dp_14" android:text="@string/chatbot_help_question_obligations" android:textColor="@color/legal_lens_auth_accent" android:textSize="@dimen/sp_13" />
            <TextView android:id="@+id/helpQuestionTermination" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:padding="@dimen/dp_14" android:text="@string/chatbot_help_question_termination" android:textColor="@color/legal_lens_auth_accent" android:textSize="@dimen/sp_13" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_24" android:text="@string/chatbot_help_faq" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_16" android:textStyle="bold" />
            <include android:id="@+id/helpFaqEvidence" layout="@layout/item_chatbot_help_faq" />
            <include android:id="@+id/helpFaqUnreadable" layout="@layout/item_chatbot_help_faq" />
            <include android:id="@+id/helpFaqFollowup" layout="@layout/item_chatbot_help_faq" />
            <include android:id="@+id/helpFaqVerify" layout="@layout/item_chatbot_help_faq" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_20" android:background="@drawable/bg_compare_warning" android:padding="@dimen/dp_12" android:text="@string/chatbot_help_warning" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
