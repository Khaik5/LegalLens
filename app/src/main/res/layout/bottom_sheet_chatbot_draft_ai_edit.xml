<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/draftAiSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chatbot_attachment_sheet"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/dp_24"
    android:paddingTop="@dimen/dp_12"
    android:paddingEnd="@dimen/dp_24"
    android:paddingBottom="@dimen/dp_24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_4"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_chatbot_draft_pending_action" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:fontFamily="@font/manrope"
            android:text="@string/chatbot_draft_ai_sheet_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:fontFamily="@font/manrope"
            android:text="@string/chatbot_draft_ai_document_name"
            android:textColor="@color/legal_lens_status_text"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:fontFamily="@font/manrope"
            android:text="@string/chatbot_draft_ai_document_metadata"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/draftAiWholeScope"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_44"
                android:layout_marginEnd="@dimen/dp_8"
                android:layout_weight="1"
                android:background="@drawable/bg_chatbot_new_state_suggestion"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/chatbot_draft_ai_scope_whole"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/draftAiSelectedScope"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_44"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_weight="1"
                android:background="@drawable/bg_chatbot_new_state_suggestion"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/chatbot_draft_ai_scope_selected"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>

        <TextView
            android:id="@+id/draftAiScopeNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:background="@color/legal_lens_auth_icon_background"
            android:drawableStart="@drawable/ic_credit_low_info"
            android:drawablePadding="@dimen/dp_8"
            android:gravity="center_vertical"
            android:lineSpacingExtra="@dimen/dp_4"
            android:padding="@dimen/dp_12"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:fontFamily="@font/manrope"
            android:text="@string/chatbot_draft_ai_prompt_label"
            android:textColor="@color/legal_lens_status_text"
            android:textSize="@dimen/sp_14" />

        <EditText
            android:id="@+id/draftAiRequest"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_112"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_chatbot_input"
            android:fontFamily="@font/manrope"
            android:gravity="top|start"
            android:hint="@string/chatbot_draft_ai_prompt_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="@dimen/dp_12"
            android:text="@string/chatbot_draft_ai_default_request"
            android:textColor="@color/legal_lens_status_text"
            android:textColorHint="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_14" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/draftAiSuggestionTerm"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40"
                android:layout_marginEnd="@dimen/dp_8"
                android:background="@drawable/bg_chatbot_new_state_suggestion"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:text="@string/chatbot_draft_ai_suggestion_term"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/sp_12" />

            <TextView
                android:id="@+id/draftAiSuggestionPayment"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_40"
                android:background="@drawable/bg_chatbot_new_state_suggestion"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:text="@string/chatbot_draft_ai_suggestion_payment"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:fontFamily="@font/manrope"
            android:lineSpacingExtra="@dimen/dp_4"
            android:text="@string/chatbot_draft_ai_review_note"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:id="@+id/draftAiSubmit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_52"
            android:layout_marginTop="@dimen/dp_20"
            android:background="@drawable/bg_chatbot_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_ai_submit"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/draftAiCancel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_chatbot_new_state_suggestion"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_ai_cancel"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
