<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatbotHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background">

    <FrameLayout
        android:id="@+id/chatbotHistoryHeader"
        android:layout_width="0dp"
        android:layout_height="@dimen/chatbot_history_header_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/chatbotHistoryBack"
            android:layout_width="@dimen/chatbot_header_action_size"
            android:layout_height="@dimen/chatbot_header_action_size"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/dp_8"
            android:background="@android:color/transparent"
            android:contentDescription="@string/chatbot_history_back_content_description"
            android:padding="@dimen/upload_back_icon_inset"
            android:src="@drawable/ic_contract_search_back" />

        <TextView android:fontFamily="@font/manrope"
            android:id="@+id/chatbotHistoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/dp_52"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/chatbot_history_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/chatbotHistorySearch"
            android:layout_width="@dimen/chatbot_header_action_size"
            android:layout_height="@dimen/chatbot_header_action_size"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/dp_8"
            android:background="@android:color/transparent"
            android:contentDescription="@string/chatbot_history_search_content_description"
            android:padding="@dimen/chatbot_header_action_padding"
            android:src="@drawable/ic_analysis_risk_overview_more"
            app:tint="@color/legal_lens_primary" />
    </FrameLayout>

    <EditText android:fontFamily="@font/manrope"
        android:id="@+id/chatbotHistoryQuery"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:layout_marginStart="@dimen/chatbot_side_padding"
        android:layout_marginEnd="@dimen/chatbot_side_padding"
        android:background="@drawable/bg_contract_search"
        android:hint="@string/chatbot_history_search_hint"
        android:inputType="text"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:singleLine="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatbotHistoryHeader" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/chatbotHistoryScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/chatbotHistoryFooter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatbotHistoryTodayLabel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/chatbot_side_padding"
            android:paddingTop="@dimen/chatbot_history_content_top_padding"
            android:paddingEnd="@dimen/chatbot_side_padding"
            android:paddingBottom="@dimen/chatbot_history_content_bottom_padding">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatbotHistoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView android:fontFamily="@font/manrope"
                android:id="@+id/chatbotHistoryPreservationNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chatbot_grounded_notice"
                android:drawableStart="@drawable/ic_credit_low_info"
                android:drawablePadding="@dimen/dp_8"
                android:drawableTint="@color/legal_lens_auth_accent"
                android:gravity="center_vertical"
                android:padding="@dimen/chatbot_history_notice_padding"
                android:text="@string/chatbot_history_preservation_note"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView android:fontFamily="@font/manrope"
        android:id="@+id/chatbotHistoryTodayLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chatbot_side_padding"
        android:layout_marginTop="@dimen/chatbot_history_today_margin_top"
        android:layout_marginEnd="@dimen/chatbot_side_padding"
        android:text="@string/chatbot_history_today"
        android:textColor="@color/legal_lens_secondary_text"
        android:textSize="@dimen/sp_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatbotHistoryQuery" />

    <LinearLayout
        android:id="@+id/chatbotHistoryFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/legal_lens_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/chatbot_history_footer_padding"
        android:paddingTop="@dimen/chatbot_history_notice_margin_top"
        android:paddingEnd="@dimen/chatbot_history_footer_padding"
        android:paddingBottom="@dimen/chatbot_history_footer_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/chatbotHistoryNewChat"
            android:layout_width="match_parent"
            android:layout_height="@dimen/chatbot_new_state_suggestion_height"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/bg_chatbot_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView android:layout_width="@dimen/dp_18" android:layout_height="@dimen/dp_18" android:contentDescription="@null" android:src="@drawable/ic_chatbot_new_chat_add" app:tint="@color/white" />
            <TextView android:fontFamily="@font/manrope" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dp_8" android:text="@string/chatbot_history_new_conversation" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:fontFamily="@font/manrope"
        android:id="@+id/chatbotHistoryEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chatbot_history_empty"
        android:textColor="@color/legal_lens_secondary_text"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/chatbotHistoryScroll"
        app:layout_constraintBottom_toBottomOf="@id/chatbotHistoryScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
