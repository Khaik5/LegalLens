<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_background"
    tools:context=".presentation.feature.onboarding.ui.OnboardingActivity">

    <TextView
        android:id="@+id/onboarding_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/onboarding_side_padding"
        android:layout_marginTop="@dimen/onboarding_header_top"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:text="@string/onboarding_logo"
        android:textColor="@color/onboarding_navy"
        android:textSize="@dimen/onboarding_logo_text_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/onboarding_skip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/onboarding_skip_height"
        android:layout_marginTop="@dimen/onboarding_skip_top"
        android:layout_marginEnd="@dimen/onboarding_side_padding"
        android:background="@drawable/onboarding_skip_background"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:paddingStart="@dimen/onboarding_skip_horizontal_padding"
        android:paddingEnd="@dimen/onboarding_skip_horizontal_padding"
        android:text="@string/onboarding_skip"
        android:textColor="@color/onboarding_navy"
        android:textSize="@dimen/onboarding_skip_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboarding_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/onboarding_bottom_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/onboarding_bottom_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/onboarding_bottom_horizontal_padding"
        android:layout_marginEnd="@dimen/onboarding_bottom_horizontal_padding"
        android:layout_marginBottom="@dimen/onboarding_bottom_margin"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/onboarding_pagination"
            android:layout_width="match_parent"
            android:layout_height="@dimen/onboarding_pagination_height"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/onboarding_dot_one"
                android:layout_width="@dimen/onboarding_dot_active_width"
                android:layout_height="@dimen/onboarding_dot_size"
                android:background="@drawable/onboarding_dot_active" />

            <View
                android:id="@+id/onboarding_dot_two"
                android:layout_width="@dimen/onboarding_dot_size"
                android:layout_height="@dimen/onboarding_dot_size"
                android:layout_marginStart="@dimen/onboarding_dot_gap"
                android:background="@drawable/onboarding_dot_inactive" />

            <View
                android:id="@+id/onboarding_dot_three"
                android:layout_width="@dimen/onboarding_dot_size"
                android:layout_height="@dimen/onboarding_dot_size"
                android:layout_marginStart="@dimen/onboarding_dot_gap"
                android:background="@drawable/onboarding_dot_inactive" />
        </LinearLayout>

        <TextView
            android:id="@+id/onboarding_next"
            android:layout_width="match_parent"
            android:layout_height="@dimen/onboarding_cta_height"
            android:layout_marginTop="@dimen/onboarding_cta_top"
            android:background="@drawable/onboarding_cta_background"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:textColor="@color/onboarding_white"
            android:textSize="@dimen/onboarding_cta_text_size"
            android:textStyle="bold" />

        <View
            android:layout_width="@dimen/onboarding_nav_handle_width"
            android:layout_height="@dimen/onboarding_nav_handle_height"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/onboarding_nav_handle_top"
            android:background="@drawable/onboarding_nav_handle" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
