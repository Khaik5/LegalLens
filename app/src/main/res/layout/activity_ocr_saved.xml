<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ocr_saved_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocr_saved_background">

    <LinearLayout
        android:id="@+id/ocr_saved_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/ocr_saved_side_padding"
        android:paddingTop="@dimen/ocr_saved_content_top_padding"
        android:paddingEnd="@dimen/ocr_saved_side_padding"
        android:paddingBottom="@dimen/ocr_saved_content_bottom_padding"
        app:layout_constraintBottom_toTopOf="@id/ocr_saved_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="@dimen/ocr_saved_completion_ring_size"
            android:layout_height="@dimen/ocr_saved_completion_ring_size"
            android:background="@drawable/bg_ocr_saved_completion_ring">

            <ImageView
                android:layout_width="@dimen/ocr_saved_completion_check_size"
                android:layout_height="@dimen/ocr_saved_completion_check_size"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_ocr_saved_check" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ocr_saved_heading_top_margin"
            android:gravity="center"
            android:text="@string/ocr_saved_title"
            android:textColor="@color/ocr_saved_navy"
            android:textSize="@dimen/ocr_saved_heading_text_size"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ocr_saved_message_top_margin"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/ocr_saved_message_line_spacing"
            android:text="@string/ocr_saved_message"
            android:textColor="@color/ocr_saved_body"
            android:textSize="@dimen/ocr_saved_message_text_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ocr_saved_document_card_height"
            android:layout_marginTop="@dimen/ocr_saved_document_card_top_margin"
            android:background="@drawable/bg_ocr_saved_document_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ocr_saved_document_card_padding"
            android:paddingEnd="@dimen/ocr_saved_document_card_padding">

            <FrameLayout
                android:layout_width="@dimen/ocr_saved_document_icon_size"
                android:layout_height="@dimen/ocr_saved_document_icon_size"
                android:background="@drawable/bg_ocr_saved_document_icon">

                <ImageView
                    android:layout_width="@dimen/ocr_saved_document_icon_art_size"
                    android:layout_height="@dimen/ocr_saved_document_icon_art_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ocr_saved_document" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ocr_saved_document_text_margin_start"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ocr_saved_document_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ocr_saved_navy"
                    android:textSize="@dimen/ocr_saved_document_name_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ocr_saved_document_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ocr_saved_document_status_top_margin"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ocr_saved_body"
                    android:textSize="@dimen/ocr_saved_document_status_text_size" />
            </LinearLayout>

            <TextView
                android:id="@+id/ocr_saved_document_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:textColor="@color/ocr_saved_teal"
                android:textSize="@dimen/ocr_saved_document_version_text_size"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ocr_saved_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ocr_saved_side_padding"
        android:paddingEnd="@dimen/ocr_saved_side_padding"
        android:paddingBottom="@dimen/ocr_saved_footer_bottom_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/ocr_saved_return"
            android:layout_width="0dp"
            android:layout_height="@dimen/ocr_saved_action_height"
            android:layout_weight="1"
            android:background="@drawable/bg_ocr_failure_secondary_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/ocr_saved_return"
            android:textColor="@color/ocr_saved_navy"
            android:textSize="@dimen/ocr_saved_action_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ocr_saved_analyze"
            android:layout_width="0dp"
            android:layout_height="@dimen/ocr_saved_action_height"
            android:layout_marginStart="@dimen/ocr_saved_action_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_ocr_failure_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/ocr_saved_analyze"
            android:textColor="@color/ocr_saved_white"
            android:textSize="@dimen/ocr_saved_action_text_size"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
