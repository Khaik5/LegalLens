    <TextView android:id="@+id/exportDemoNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:text="@string/contract_export_demo_notice" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
