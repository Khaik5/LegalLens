    <TextView android:id="@+id/exportSave" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_compare_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/contract_export_save" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
    <TextView android:id="@+id/exportShare" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_12" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/contract_export_share" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
