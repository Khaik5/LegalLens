<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12">
        <ImageButton
            android:id="@+id/draftVersionsBack"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_draft_back"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_contract_search_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_weight="1"
            android:fontFamily="@font/manrope"
            android:text="@string/chatbot_draft_versions_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold" />
        <ImageButton
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_draft_more"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_analysis_risk_overview_more" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_20">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/chatbot_draft_versions_contract_name"
                android:textColor="@color/legal_lens_status_text"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_ai_review_selected"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chatbot_source_badge"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="@dimen/dp_8"
                    android:paddingTop="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_4"
                    android:text="@string/chatbot_draft_version_d2_status"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:fontFamily="@font/manrope"
                    android:text="@string/chatbot_draft_version_d2_title"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:fontFamily="@font/manrope"
                    android:text="@string/chatbot_draft_version_d2_body"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_12" />
                <TextView
                    android:id="@+id/draftVersionD2View"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:layout_marginTop="@dimen/dp_8"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:text="@string/chatbot_draft_version_view_d2"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_source_document"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chatbot_source_badge"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="@dimen/dp_8"
                    android:paddingTop="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_4"
                    android:text="@string/chatbot_draft_version_d1_status"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:fontFamily="@font/manrope"
                    android:text="@string/chatbot_draft_version_d1_title"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:fontFamily="@font/manrope"
                    android:text="@string/chatbot_draft_version_d1_body"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_12" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:layout_marginTop="@dimen/dp_8"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/draftVersionD1View"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/manrope"
                        android:gravity="center"
                        android:text="@string/chatbot_draft_version_view_d1"
                        android:textColor="@color/legal_lens_auth_accent"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/draftVersionD1Copy"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/manrope"
                        android:gravity="center"
                        android:text="@string/chatbot_draft_copy_from_d1"
                        android:textColor="@color/legal_lens_auth_accent"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/draftVersionD3Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_source_document"
                android:orientation="vertical"
                android:padding="@dimen/dp_16"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chatbot_source_badge"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="@dimen/dp_8"
                    android:paddingTop="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_4"
                    android:text="@string/chatbot_draft_version_d3_status"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:fontFamily="@font/manrope"
                    android:text="@string/chatbot_draft_version_d3_title"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/draftVersionD3View"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:layout_marginTop="@dimen/dp_8"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:text="@string/chatbot_draft_version_view_d3"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_source_document"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chatbot_new_state_suggestion"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="@dimen/dp_8"
                    android:paddingTop="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_4"
                    android:text="@string/chatbot_draft_version_original_status"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:fontFamily="@font/manrope"
                    android:text="@string/chatbot_draft_version_original_title"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:fontFamily="@font/manrope"
                    android:text="@string/chatbot_draft_version_original_body"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_12" />
                <TextView
                    android:id="@+id/draftVersionOriginalView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:layout_marginTop="@dimen/dp_8"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:text="@string/chatbot_draft_version_view_original"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_ai_review_after"
                android:drawableStart="@drawable/ic_credit_low_info"
                android:drawablePadding="@dimen/dp_8"
                android:gravity="center_vertical"
                android:padding="@dimen/dp_12"
                android:text="@string/chatbot_draft_versions_optional_note"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/draftVersionsCompare"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_12"
        android:background="@drawable/bg_chatbot_primary_action"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:text="@string/chatbot_draft_versions_compare"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_15"
        android:textStyle="bold" />
</LinearLayout>
