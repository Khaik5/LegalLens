<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_permission_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/upload_background">

    <LinearLayout
        android:id="@+id/camera_permission_app_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/camera_permission_app_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/camera_permission_side_padding"
        android:paddingEnd="@dimen/camera_permission_side_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/camera_permission_back"
            android:layout_width="@dimen/upload_back_button_size"
            android:layout_height="@dimen/upload_back_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/camera_permission_back_description"
            android:padding="@dimen/upload_back_icon_inset"
            android:src="@drawable/ic_upload_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/upload_title_margin_start"
            android:fontFamily="sans"
            android:text="@string/camera_permission_title"
            android:textColor="@color/upload_navy"
            android:textSize="@dimen/upload_title_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/camera_permission_icon_outer"
        android:layout_width="@dimen/camera_permission_icon_outer_size"
        android:layout_height="@dimen/camera_permission_icon_outer_size"
        android:background="@drawable/bg_camera_permission_outer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camera_permission_app_bar"
        android:layout_marginTop="@dimen/camera_permission_icon_top_margin" />

    <ImageView
        android:layout_width="@dimen/camera_permission_icon_inner_size"
        android:layout_height="@dimen/camera_permission_icon_inner_size"
        android:background="@drawable/bg_camera_permission_inner"
        android:padding="@dimen/upload_icon_inset"
        android:src="@drawable/ic_camera_permission"
        app:layout_constraintBottom_toBottomOf="@id/camera_permission_icon_outer"
        app:layout_constraintEnd_toEndOf="@id/camera_permission_icon_outer"
        app:layout_constraintStart_toStartOf="@id/camera_permission_icon_outer"
        app:layout_constraintTop_toTopOf="@id/camera_permission_icon_outer" />

    <TextView
        android:id="@+id/camera_permission_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/camera_permission_title_top_margin"
        android:text="@string/camera_permission_heading"
        android:textColor="@color/upload_navy"
        android:textSize="@dimen/camera_permission_title_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camera_permission_icon_outer" />

    <TextView
        android:id="@+id/camera_permission_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/camera_permission_side_padding"
        android:layout_marginTop="@dimen/camera_permission_description_top_margin"
        android:layout_marginEnd="@dimen/camera_permission_side_padding"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/camera_permission_description_line_spacing"
        android:text="@string/camera_permission_description"
        android:textColor="@color/upload_body"
        android:textSize="@dimen/camera_permission_description_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camera_permission_heading" />

    <LinearLayout
        android:id="@+id/camera_permission_safety"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/camera_permission_safety_top_margin"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camera_permission_description">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/camera_permission_safety_icon_size"
                android:layout_height="@dimen/camera_permission_safety_icon_size"
                android:src="@drawable/ic_camera_shield" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/camera_permission_safety_row_gap"
                android:text="@string/camera_permission_secure"
                android:textColor="@color/upload_body"
                android:textSize="@dimen/camera_permission_safety_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/camera_permission_safety_row_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/camera_permission_safety_icon_size"
                android:layout_height="@dimen/camera_permission_safety_icon_size"
                android:src="@drawable/ic_camera_bolt" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/camera_permission_safety_row_gap"
                android:text="@string/camera_permission_manual"
                android:textColor="@color/upload_body"
                android:textSize="@dimen/camera_permission_safety_text_size" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/camera_permission_side_padding"
        android:layout_marginEnd="@dimen/camera_permission_side_padding"
        android:paddingBottom="@dimen/camera_permission_buttons_bottom_padding"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/camera_permission_allow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/camera_permission_button_height"
            android:background="@drawable/bg_camera_permission_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/camera_permission_allow"
            android:textColor="@color/white"
            android:textSize="@dimen/upload_card_description_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/camera_permission_later"
            android:layout_width="match_parent"
            android:layout_height="@dimen/camera_permission_button_height"
            android:layout_marginTop="@dimen/camera_permission_button_bottom_margin"
            android:background="@drawable/bg_camera_permission_secondary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/camera_permission_later"
            android:textColor="@color/upload_navy"
            android:textSize="@dimen/upload_card_description_text_size"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
