<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/unlockConfirmationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background"
    tools:context=".presentation.feature.creditstore.unlock.ui.UnlockConfirmationActivity">

    <LinearLayout
        android:id="@+id/unlockConfirmationHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:minHeight="@dimen/dp_56"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/unlockConfirmationBack"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/unlock_confirmation_back_description"
            android:padding="@dimen/dp_8"
            android:src="@drawable/ic_credit_store_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/unlock_confirmation_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/unlockConfirmationActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/legal_lens_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_24"
        android:paddingTop="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/unlockConfirmationConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/dp_54"
            android:background="@drawable/bg_unlock_confirmation_primary_action"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:minWidth="@dimen/dp_0"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            app:backgroundTint="@null"
            tools:text="Xác nhận mở khóa · 2 Credits" />

        <Button
            android:id="@+id/unlockConfirmationCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_4"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:minWidth="@dimen/dp_0"
            android:text="@string/unlock_confirmation_cancel"
            android:textAllCaps="false"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/unlockConfirmationActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/unlockConfirmationHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_24"
            android:paddingTop="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_24"
            android:paddingBottom="@dimen/dp_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/dp_44"
                    android:layout_height="@dimen/dp_44"
                    android:background="@drawable/bg_unlock_confirmation_icon">

                    <ImageView
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:layout_gravity="center"
                        android:contentDescription="@string/unlock_confirmation_shield_description"
                        android:src="@drawable/ic_unlock_confirmation_shield" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/unlock_confirmation_heading"
                        android:textColor="@color/legal_lens_primary"
                        android:textSize="@dimen/sp_24"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="1.35"
                        android:text="@string/unlock_confirmation_description"
                        android:textColor="@color/legal_lens_secondary_text"
                        android:textSize="@dimen/sp_14" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:background="@drawable/bg_contract_card"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="@string/unlock_confirmation_result_title"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/unlockConfirmationResultMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_13"
                    tools:text="Mã KQ-1042 · Đã xem 40% miễn phí" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@color/legal_lens_input_stroke" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="@string/unlock_confirmation_contract_label"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_13" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="@string/contract_office_lease"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:text="@string/unlock_confirmation_current_label"
                            android:textColor="@color/legal_lens_secondary_text"
                            android:textSize="@dimen/sp_12" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:text="@string/unlock_confirmation_current_value"
                            android:textColor="@color/legal_lens_primary"
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:text="@string/unlock_confirmation_unlocked_label"
                            android:textColor="@color/legal_lens_secondary_text"
                            android:textSize="@dimen/sp_12" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:text="@string/unlock_confirmation_unlocked_value"
                            android:textColor="@color/legal_lens_auth_accent"
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/unlock_confirmation_payment_title"
                android:textColor="@color/legal_lens_primary"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@drawable/bg_contract_card"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/unlock_confirmation_balance_before"
                        android:textColor="@color/legal_lens_secondary_text"
                        android:textSize="@dimen/sp_14" />

                    <TextView
                        android:id="@+id/unlockConfirmationBalanceBefore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:textColor="@color/legal_lens_primary"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"
                        tools:text="5 Credits" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@color/legal_lens_input_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/unlock_confirmation_deduction"
                        android:textColor="@color/legal_lens_secondary_text"
                        android:textSize="@dimen/sp_14" />

                    <TextView
                        android:id="@+id/unlockConfirmationCost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:textColor="@color/legal_lens_primary"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"
                        tools:text="−2 Credits" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@color/legal_lens_input_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/unlock_confirmation_balance_after"
                        android:textColor="@color/legal_lens_secondary_text"
                        android:textSize="@dimen/sp_14" />

                    <TextView
                        android:id="@+id/unlockConfirmationBalanceAfter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:textColor="@color/legal_lens_auth_accent"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"
                        tools:text="3 Credits" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_unlock_confirmation_note"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <ImageView
                    android:layout_width="@dimen/dp_18"
                    android:layout_height="@dimen/dp_18"
                    android:contentDescription="@string/unlock_confirmation_info_description"
                    android:src="@drawable/ic_unlock_confirmation_info" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/unlock_confirmation_note"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
