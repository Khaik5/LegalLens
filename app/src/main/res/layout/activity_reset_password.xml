<?xml version="1.0" encoding="utf-8"?>
<!-- The keyboard inset is padded on this root so the ScrollView shrinks and scrolls the focused field into view. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resetPasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background"
    tools:ignore="UselessParent">

    <ScrollView
        android:id="@+id/resetPasswordScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_24"
            android:paddingTop="@dimen/dp_53"
            android:paddingBottom="@dimen/dp_24">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="@dimen/dp_8"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/legal_lens_status_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:includeFontPadding="false"
                android:text="@string/reset_password_new_title"
                android:textColor="@color/legal_lens_status_text"
                android:textSize="@dimen/sp_24"
                android:textStyle="bold" />

            <TextView
                style="@style/AuthFieldLabel"
                android:layout_marginTop="@dimen/dp_28"
                android:text="@string/password" />

            <EditText
                android:id="@+id/passwordInput"
                style="@style/AuthInput"
                android:hint="@string/password_hint"
                android:inputType="textPassword" />

            <TextView
                style="@style/AuthFieldLabel"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/confirm_password" />

            <EditText
                android:id="@+id/confirmPasswordInput"
                style="@style/AuthInput"
                android:hint="@string/password_hint"
                android:inputType="textPassword" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_54"
                android:layout_marginTop="@dimen/dp_24"
                android:elevation="@dimen/dp_0"
                android:insetLeft="@dimen/dp_0"
                android:insetTop="@dimen/dp_0"
                android:insetRight="@dimen/dp_0"
                android:insetBottom="@dimen/dp_0"
                android:text="@string/reset_password_submit"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                app:backgroundTint="@color/legal_lens_primary"
                app:cornerRadius="@dimen/dp_14" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
