<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/draftManualEditRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12">

        <ImageButton
            android:id="@+id/draftManualBack"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_draft_back"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_contract_search_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_weight="1"
            android:fontFamily="@font/manrope"
            android:text="@string/chatbot_draft_manual_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold" />

        <ImageButton
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_draft_more"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_analysis_risk_overview_more" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/draftManualDocumentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/chatbot_draft_manual_document_name"
                android:textColor="@color/legal_lens_status_text"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_36"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@drawable/bg_chatbot_source_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/dp_8"
                android:paddingEnd="@dimen/dp_8">

                <TextView
                    android:id="@+id/draftManualVersionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:text="@string/chatbot_draft_manual_unsaved_badge"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/draftFormatBold"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/draftFormatItalic"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:text="I"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/draftFormatList"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:text="☷"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:background="@color/legal_lens_auth_icon_background"
                android:drawableStart="@drawable/ic_credit_low_info"
                android:drawablePadding="@dimen/dp_8"
                android:gravity="center_vertical"
                android:lineSpacingExtra="@dimen/dp_2"
                android:padding="@dimen/dp_12"
                android:text="@string/chatbot_draft_manual_scope_note"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_source_document"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:text="@string/chatbot_draft_section_2_title"
                    android:textColor="@color/legal_lens_primary"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/draftManualClauseBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/manrope"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="@dimen/dp_168"
                    android:padding="0dp"
                    android:textColor="@color/legal_lens_status_text"
                    android:textSize="@dimen/sp_14" />

                <EditText
                    android:id="@+id/draftManualAddition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/manrope"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="@dimen/dp_48"
                    android:padding="0dp"
                    android:textColor="@color/legal_lens_auth_accent"
                    android:textSize="@dimen/sp_14" />
            </LinearLayout>

            <TextView
                android:id="@+id/draftManualSelectAnother"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_12"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:text="@string/chatbot_draft_manual_select_another"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/legal_lens_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_12">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:text="@string/chatbot_draft_manual_preserve_note"
            android:textColor="@color/legal_lens_secondary_text"
            android:textSize="@dimen/sp_12" />

        <TextView
            android:id="@+id/draftManualSave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_chatbot_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_manual_save_action"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/draftManualCancel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_chatbot_new_state_suggestion"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_manual_cancel_action"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
