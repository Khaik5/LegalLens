<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/forgotPasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background"
    tools:context=".presentation.feature.forgotpassword.ui.ForgotPasswordActivity">

    <ScrollView
        android:id="@+id/forgotPasswordScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_24"
            android:paddingTop="@dimen/dp_53"
            android:paddingBottom="@dimen/dp_171">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:padding="@dimen/dp_8"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/legal_lens_status_text" />

                <TextView
                    android:id="@+id/headerTitleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/forgot_password"
                    android:textColor="@color/legal_lens_status_text"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageView
                android:id="@+id/keyIcon"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_24"
                android:contentDescription="@string/reset_password_icon_description"
                android:padding="@dimen/dp_8"
                android:src="@drawable/ic_key"
                android:background="@drawable/bg_auth_key_icon" />

            <TextView
                android:id="@+id/forgotPasswordTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:includeFontPadding="false"
                android:text="@string/reset_password_title"
                android:textColor="@color/legal_lens_status_text"
                android:textSize="@dimen/sp_24"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/forgotPasswordSubtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:includeFontPadding="false"
                android:lineSpacingExtra="@dimen/dp_0"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/reset_password_subtitle"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_14" />

            <TextView
                android:id="@+id/emailLabel"
                style="@style/AuthFieldLabel"
                android:layout_marginTop="@dimen/dp_28"
                android:text="@string/email_address" />

            <EditText
                android:id="@+id/emailInput"
                style="@style/AuthInput"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_54"
                android:elevation="@dimen/dp_0"
                android:fontFamily="sans-serif"
                android:insetLeft="@dimen/dp_0"
                android:insetTop="@dimen/dp_0"
                android:insetRight="@dimen/dp_0"
                android:insetBottom="@dimen/dp_0"
                android:text="@string/send_reset_link"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                app:backgroundTint="@color/legal_lens_primary"
                app:cornerRadius="@dimen/dp_14" />

            <TextView
                android:id="@+id/loginText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/back_to_login"
                android:textColor="@color/legal_lens_link"
                android:textSize="@dimen/sp_15" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
