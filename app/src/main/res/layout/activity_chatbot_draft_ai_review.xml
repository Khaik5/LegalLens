<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12">

        <ImageButton
            android:id="@+id/draftAiReviewBack"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_draft_back"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_contract_search_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_weight="1"
            android:fontFamily="@font/manrope"
            android:text="@string/chatbot_draft_ai_review_title"
            android:textColor="@color/legal_lens_primary"
            android:textSize="@dimen/sp_18"
            android:textStyle="bold" />

        <ImageButton
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chatbot_draft_more"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_analysis_risk_overview_more" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/chatbot_draft_ai_document_name"
                android:textColor="@color/legal_lens_status_text"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:fontFamily="@font/manrope"
                android:text="@string/chatbot_draft_ai_review_metadata"
                android:textColor="@color/legal_lens_secondary_text"
                android:textSize="@dimen/sp_12" />

            <LinearLayout
                android:id="@+id/draftAiReviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_ai_review_selected"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope"
                        android:text="@string/chatbot_draft_ai_review_clause"
                        android:textColor="@color/legal_lens_primary"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/draftAiReviewStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chatbot_source_badge"
                        android:fontFamily="@font/manrope"
                        android:paddingStart="@dimen/dp_8"
                        android:paddingTop="@dimen/dp_4"
                        android:paddingEnd="@dimen/dp_8"
                        android:paddingBottom="@dimen/dp_4"
                        android:text="@string/chatbot_draft_ai_review_selected"
                        android:textColor="@color/legal_lens_auth_accent"
                        android:textSize="@dimen/sp_11"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="@drawable/bg_chatbot_ai_review_before"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_12">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope"
                        android:text="@string/chatbot_draft_ai_review_before_label"
                        android:textColor="@color/legal_lens_secondary_text"
                        android:textSize="@dimen/sp_11"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:fontFamily="@font/manrope"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:text="@string/chatbot_draft_ai_review_before"
                        android:textColor="@color/legal_lens_status_text"
                        android:textSize="@dimen/sp_14" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:background="@drawable/bg_chatbot_ai_review_after"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_12">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope"
                        android:text="@string/chatbot_draft_ai_review_after_label"
                        android:textColor="@color/legal_lens_auth_accent"
                        android:textSize="@dimen/sp_11"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:fontFamily="@font/manrope"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:text="@string/chatbot_draft_ai_review_after"
                        android:textColor="@color/legal_lens_status_text"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:fontFamily="@font/manrope"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:text="@string/chatbot_draft_ai_review_reason"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_12" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginTop="@dimen/dp_12"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/draftAiReviewAccept"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/dp_4"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chatbot_primary_action"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/manrope"
                        android:gravity="center"
                        android:text="@string/chatbot_draft_ai_review_accept_selected"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/draftAiReviewReject"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/dp_4"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chatbot_new_state_suggestion"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/manrope"
                        android:gravity="center"
                        android:text="@string/chatbot_draft_ai_review_reject"
                        android:textColor="@color/legal_lens_primary"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:background="@drawable/bg_chatbot_ai_review_after"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dp_12">

                <ImageView
                    android:layout_width="@dimen/dp_18"
                    android:layout_height="@dimen/dp_18"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_credit_low_info"
                    app:tint="@color/legal_lens_auth_accent" />

                <TextView
                    android:id="@+id/draftAiReviewNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:text="@string/chatbot_draft_ai_review_note_accepted"
                    android:textColor="@color/legal_lens_secondary_text"
                    android:textSize="@dimen/sp_12" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/legal_lens_background"
        android:elevation="@dimen/dp_4"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/draftAiReviewCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:text="@string/chatbot_draft_ai_review_count_accepted"
                android:textColor="@color/legal_lens_status_text"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/chatbot_draft_ai_review_not_applied"
                android:textColor="@color/legal_lens_auth_accent"
                android:textSize="@dimen/sp_12" />
        </LinearLayout>

        <TextView
            android:id="@+id/draftAiReviewContinue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_chatbot_primary_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:text="@string/chatbot_draft_ai_review_continue"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_15"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
