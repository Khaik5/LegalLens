<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legal_lens_background"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/dp_64" android:gravity="center_vertical" android:paddingStart="@dimen/dp_12" android:paddingEnd="@dimen/dp_12">
        <ImageButton android:id="@+id/savedDraftBack" android:layout_width="@dimen/dp_44" android:layout_height="@dimen/dp_44" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/chatbot_draft_back" android:padding="@dimen/dp_12" android:src="@drawable/ic_contract_search_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dp_8" android:layout_weight="1" android:fontFamily="@font/manrope" android:text="@string/draft_saved_detail_title" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_18" android:textStyle="bold" />
        <ImageButton android:layout_width="@dimen/dp_44" android:layout_height="@dimen/dp_44" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/chatbot_draft_more" android:padding="@dimen/dp_12" android:src="@drawable/ic_analysis_risk_overview_more" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@color/notification_system_surface" android:fillViewport="true" android:padding="@dimen/dp_16">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_chatbot_source_document" android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/dp_20">
                <ImageView android:layout_width="@dimen/dp_64" android:layout_height="@dimen/dp_64" android:background="@drawable/bg_compare_notice" android:contentDescription="@null" android:padding="@dimen/dp_16" android:src="@drawable/ic_contract_search_document" />
                <TextView android:id="@+id/savedDraftTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:fontFamily="@font/manrope" android:gravity="center" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_16" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:background="@drawable/bg_chatbot_source_badge" android:fontFamily="@font/manrope" android:paddingStart="@dimen/dp_8" android:paddingTop="@dimen/dp_4" android:paddingEnd="@dimen/dp_8" android:paddingBottom="@dimen/dp_4" android:text="@string/draft_saved_badge" android:textColor="@color/legal_lens_auth_accent" android:textSize="@dimen/sp_11" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_12" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_saved_metadata" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_13" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_chatbot_draft_warning" android:drawableStart="@drawable/ic_chatbot_error" android:drawablePadding="@dimen/dp_8" android:gravity="center_vertical" android:padding="@dimen/dp_12" android:text="@string/draft_save_legal_warning" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:background="@drawable/bg_chatbot_source_document" android:orientation="vertical" android:padding="@dimen/dp_16">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope" android:text="@string/draft_saved_location_label" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_4" android:fontFamily="@font/manrope" android:text="@string/draft_saved_location" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_14" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_8" android:fontFamily="@font/manrope" android:text="@string/draft_saved_detail_note" android:textColor="@color/legal_lens_secondary_text" android:textSize="@dimen/sp_12" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/dp_16" android:paddingTop="@dimen/dp_8" android:paddingEnd="@dimen/dp_16" android:paddingBottom="@dimen/dp_12">
        <TextView android:id="@+id/savedDraftView" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:background="@drawable/bg_chatbot_primary_action" android:clickable="true" android:focusable="true" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_saved_view_button" android:textColor="@color/white" android:textSize="@dimen/sp_15" android:textStyle="bold" />
        <TextView android:id="@+id/savedDraftExport" android:layout_width="match_parent" android:layout_height="@dimen/dp_50" android:layout_marginTop="@dimen/dp_8" android:background="@drawable/bg_contract_search_result" android:clickable="true" android:focusable="true" android:fontFamily="@font/manrope" android:gravity="center" android:text="@string/draft_saved_export_button" android:textColor="@color/legal_lens_primary" android:textSize="@dimen/sp_15" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
